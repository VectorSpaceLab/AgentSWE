+// @vitest-environment node
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { acceptanceContracts, acceptanceEvents } from "../types/acceptance";
+import { createAttestation, createSession, ensureAcceptanceRun, getAttestation, getRun, resetAcceptanceStoreForTesting, updateSession } from "./acceptance_store";
+
+describe("typed Acceptance ledger", () => {
+  let userData: string;
+  let appPath: string;
+  beforeEach(async () => {
+    userData = await fs.mkdtemp(path.join(os.tmpdir(), "dyad-acceptance-"));
+    appPath = await fs.mkdtemp(path.join(os.tmpdir(), "dyad-app-"));
+    await fs.mkdir(path.join(appPath, "e2e-tests"));
+    await fs.writeFile(path.join(appPath, "e2e-tests", "acceptance.spec.ts"), "test('acceptance', async () => {});\n");
+    process.env.DYAD_DEV_USER_DATA_DIR = userData;
+    resetAcceptanceStoreForTesting();
+  });
+  afterEach(async () => {
+    resetAcceptanceStoreForTesting();
+    await fs.rm(userData, { recursive: true, force: true });
+    await fs.rm(appPath, { recursive: true, force: true });
+  });
+
+  it("exposes typed channels/events and persists an acceptance run across reload", async () => {
+    expect(acceptanceContracts.startPreview.channel).toBe("acceptance:start-preview");
+    expect(acceptanceEvents.attestationUpdated.channel).toBe("acceptance:attestation-updated");
+    const run = await ensureAcceptanceRun(1, 2, appPath);
+    resetAcceptanceStoreForTesting();
+    expect(await getRun({ appId: 1, chatId: 2, runId: run.runId })).toEqual(run);
+  });
+
+  it("deduplicates operation ids and freezes terminal attestation", async () => {
+    const run = await ensureAcceptanceRun(1, 2, appPath);
+    const input = { appId: 1, chatId: 2, runId: run.runId, generation: 0, operationId: "op-1", target: { testFile: "e2e-tests/acceptance.spec.ts", grep: null }, startedRevision: "rev-a", testFingerprint: "test-a" };
+    const first = await createSession(input);
+    const retry = await createSession(input);
+    expect(retry).toEqual(first);
+    const attestation = await createAttestation({ schemaVersion: 1, runId: run.runId, sessionId: first.sessionId, appId: 1, chatId: 2, generation: 0, startedRevision: "rev-a", finishedRevision: "rev-b", testFingerprint: "test-a", outcome: "passed", resultDigest: "digest", completedSequence: 3 });
+    await updateSession(first.sessionId, { status: "passed", finishedRevision: "rev-b", attestationId: attestation.attestationId });
+    expect(await getAttestation({ appId: 1, chatId: 2, attestationId: attestation.attestationId })).toEqual(attestation);
+    expect((await updateSession(first.sessionId, { status: "failed" })).status).toBe("passed");
+  });
+});
diff --git a/src/ipc/services/acceptance_store.ts b/src/ipc/services/acceptance_store.ts
new file mode 100644
index 0000000..1703260
--- /dev/null
+++ b/src/ipc/services/acceptance_store.ts
@@ -0,0 +1,84 @@
+import crypto from "node:crypto";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { getUserDataPath } from "@/paths/paths";
+import type { AcceptanceControlReceipt, AcceptancePreviewSession, AcceptanceRunSnapshot, AcceptanceTestAttestation } from "../types/acceptance";
+
+type State = { runs: AcceptanceRunSnapshot[]; sessions: AcceptancePreviewSession[]; receipts: AcceptanceControlReceipt[]; attestations: AcceptanceTestAttestation[] };
+const empty = (): State => ({ runs: [], sessions: [], receipts: [], attestations: [] });
+let state: State | undefined;
+let writeChain = Promise.resolve();
+const filePath = () => path.join(getUserDataPath(), "acceptance-ledger.json");
+const id = (prefix: string) => `${prefix}_${crypto.randomUUID()}`;
+const digest = (value: unknown) => crypto.createHash("sha256").update(JSON.stringify(value)).digest("hex");
+
+async function load(): Promise<State> {
+  if (state) return state;
+  try { state = JSON.parse(await fs.readFile(filePath(), "utf8")) as State; } catch { state = empty(); }
+  return state;
+}
+async function persist(): Promise<void> {
+  const snapshot = JSON.stringify(state ?? empty(), null, 2) + "\n";
+  writeChain = writeChain.then(async () => {
+    await fs.mkdir(path.dirname(filePath()), { recursive: true });
+    const tmp = `${filePath()}.${process.pid}.tmp`;
+    await fs.writeFile(tmp, snapshot, { mode: 0o600 });
+    await fs.rename(tmp, filePath());
+  });
+  await writeChain;
+}
+export function resetAcceptanceStoreForTesting(): void { state = undefined; }
+export async function acceptanceRevision(appPath: string): Promise<string> {
+  const entries: Array<{ path: string; data: string }> = [];
+  async function walk(dir: string): Promise<void> { for (const entry of await fs.readdir(dir, { withFileTypes: true }).catch(() => [])) { if (["node_modules", ".git", "out", "dist"].includes(entry.name)) continue; const full = path.join(dir, entry.name); const rel = path.relative(appPath, full).split(path.sep).join("/"); if (entry.isDirectory()) await walk(full); else if (entry.isFile() && (/^(src|e2e-tests)\//.test(rel) || /^(package|pnpm-lock|yarn.lock|package-lock)\./.test(rel))) entries.push({ path: rel, data: (await fs.readFile(full)).toString("base64") }); } }
+  await walk(appPath); entries.sort((a, b) => a.path.localeCompare(b.path)); return digest(entries);
+}
+export async function acceptanceTestFingerprint(appPath: string, testFile: string): Promise<string> { return digest({ testFile, bytes: (await fs.readFile(path.join(appPath, testFile))).toString("base64") }); }
+async function targetForApp(appPath: string): Promise<string> {
+  const root = path.join(appPath, "e2e-tests");
+  const files: string[] = [];
+  async function walk(dir: string): Promise<void> { for (const entry of await fs.readdir(dir, { withFileTypes: true }).catch(() => [])) { const full = path.join(dir, entry.name); if (entry.isDirectory()) await walk(full); else if (/\.spec\.(ts|tsx|js|jsx)$/.test(entry.name)) files.push(path.relative(appPath, full).split(path.sep).join("/")); } }
+  await walk(root); files.sort();
+  return files[0] ?? "e2e-tests/acceptance.spec.ts";
+}
+export async function ensureAcceptanceRun(appId: number, chatId: number, appPath: string): Promise<AcceptanceRunSnapshot> {
+  const s = await load(); const existing = s.runs.find((r) => r.appId === appId && r.chatId === chatId);
+  if (existing) return existing;
+  const target = await targetForApp(appPath);
+  const run: AcceptanceRunSnapshot = { schemaVersion: 1, runId: id("run"), appId, chatId, status: "draft", generation: 0, controlSequence: 0, specificationHash: digest({ appId, chatId, target }), requirements: ["candidate acceptance evidence"], evidence: [{ source: "acceptance-chat", ordinaryChat: false }], testRuns: [{ sessionId: "pending", target: { testFile: target, grep: null }, status: "queued", attestationId: null }], changedPaths: [], unresolved: [], integrityViolations: [], repairBudget: 2 };
+  s.runs.push(run); await persist(); return run;
+}
+export async function getRun(scope: { appId: number; chatId: number; runId?: string }): Promise<AcceptanceRunSnapshot | null> { const s = await load(); return s.runs.find((r) => r.appId === scope.appId && r.chatId === scope.chatId && (!scope.runId || r.runId === scope.runId)) ?? null; }
+export async function getSession(scope: { appId: number; chatId: number; sessionId: string }): Promise<AcceptancePreviewSession | null> { const s = await load(); return s.sessions.find((x) => x.appId === scope.appId && x.chatId === scope.chatId && x.sessionId === scope.sessionId) ?? null; }
+export async function getAttestation(scope: { appId: number; chatId: number; attestationId: string }): Promise<AcceptanceTestAttestation | null> { const s = await load(); return s.attestations.find((x) => x.appId === scope.appId && x.chatId === scope.chatId && x.attestationId === scope.attestationId) ?? null; }
+export async function getReceipt(scope: { appId: number; chatId: number; receiptId: string }): Promise<AcceptanceControlReceipt | null> { const s = await load(); return s.receipts.find((x) => x.appId === scope.appId && x.chatId === scope.chatId && x.receiptId === scope.receiptId) ?? null; }
+export async function cancelAcceptanceSessionsForApp(appId: number): Promise<void> {
