+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const handlers = new Map<string, unknown>();
+vi.mock("electron", () => ({
+  ipcMain: { handle: vi.fn((channel: string, handler: unknown) => handlers.set(channel, handler)) },
+}));
+vi.mock("../utils/telemetry", () => ({ sendTelemetryException: vi.fn() }));
+vi.mock("../utils/test_utils", () => ({ IS_TEST_BUILD: true }));
+
+const { registerAcceptanceHandlers } = await import("./acceptance_handlers");
+const { getRegisteredHandlerForTesting } = await import("./base");
+const { VALID_INVOKE_CHANNELS, VALID_RECEIVE_CHANNELS } = await import("../preload/channels");
+
+describe("Acceptance product entry", () => {
+  beforeEach(() => { handlers.clear(); registerAcceptanceHandlers(); });
+
+  it("registers every typed invoke surface and exposes it through preload", () => {
+    const channels = [
+      "acceptance:get-run", "acceptance:get-latest-run", "acceptance:control-run",
+      "acceptance:get-control-receipt", "acceptance:start-preview", "acceptance:get-preview", "acceptance:get-attestation",
+    ];
+    for (const channel of channels) {
+      expect(handlers.has(channel)).toBe(true);
+      expect(() => getRegisteredHandlerForTesting(channel)).not.toThrow();
+      expect(VALID_INVOKE_CHANNELS).toContain(channel);
+    }
+    expect(VALID_RECEIVE_CHANNELS).toEqual(expect.arrayContaining([
+      "acceptance:run-updated", "acceptance:preview-updated", "acceptance:attestation-updated",
+    ]));
+  });
+});
