+import { z } from "zod";
+import { createClient, createEventClient, defineContract, defineEvent } from "../contracts/core";
+
+export const AcceptanceRunStatusSchema = z.enum(["draft", "previewing", "frozen", "passed", "failed", "cancelled", "invalidated"]);
+export const AcceptancePreviewStatusSchema = z.enum(["queued", "setup", "running", "passed", "failed", "cancelled", "infrastructure", "invalidated"]);
+
+const ScopeSchema = z.object({ appId: z.number().int().positive(), chatId: z.number().int().positive() });
+const TargetSchema = z.object({ testFile: z.string(), grep: z.string().nullable().default(null) });
+
+export const AcceptanceTestAttestationSchema = z.object({
+  schemaVersion: z.literal(1), attestationId: z.string(), runId: z.string(), sessionId: z.string(),
+  appId: z.number(), chatId: z.number(), generation: z.number().int().nonnegative(),
+  startedRevision: z.string(), finishedRevision: z.string(), testFingerprint: z.string(),
+  outcome: z.enum(["passed", "failed", "cancelled", "infrastructure", "invalidated"]),
+  resultDigest: z.string(), completedSequence: z.number().int().positive(), immutable: z.literal(true),
+});
+export type AcceptanceTestAttestation = z.infer<typeof AcceptanceTestAttestationSchema>;
+
+export const AcceptancePreviewSessionSchema = z.object({
+  schemaVersion: z.literal(1), sessionId: z.string(), runId: z.string(), ...ScopeSchema.shape,
+  generation: z.number().int().nonnegative(), operationId: z.string(), target: TargetSchema,
+  status: AcceptancePreviewStatusSchema, startedRevision: z.string(), testFingerprint: z.string(),
+  finishedRevision: z.string().nullable(), sequence: z.number().int().positive(),
+  attestationId: z.string().nullable(), immutable: z.boolean(),
+});
+export type AcceptancePreviewSession = z.infer<typeof AcceptancePreviewSessionSchema>;
+
+export const AcceptanceRunSnapshotSchema = z.object({
+  schemaVersion: z.literal(1), runId: z.string(), ...ScopeSchema.shape,
+  status: AcceptanceRunStatusSchema, generation: z.number().int().nonnegative(), controlSequence: z.number().int().nonnegative(),
+  specificationHash: z.string(), requirements: z.array(z.string()), evidence: z.array(z.record(z.string(), z.unknown())),
+  testRuns: z.array(z.object({ sessionId: z.string(), target: TargetSchema, status: AcceptancePreviewStatusSchema, attestationId: z.string().nullable() })),
+  changedPaths: z.array(z.string()), unresolved: z.array(z.string()), integrityViolations: z.array(z.string()), repairBudget: z.number().int().nonnegative(),
+});
+export type AcceptanceRunSnapshot = z.infer<typeof AcceptanceRunSnapshotSchema>;
+
+export const AcceptanceControlCommandSchema = ScopeSchema.extend({ runId: z.string(), expectedGeneration: z.number().int().nonnegative(), operationId: z.string(), command: z.enum(["freeze", "unfreeze", "cancel"]) });
+export const AcceptanceControlReceiptSchema = z.object({ receiptId: z.string(), ...ScopeSchema.shape, runId: z.string(), operationId: z.string(), command: z.string(), generation: z.number(), controlSequence: z.number(), status: z.string(), immutable: z.literal(true) });
+export type AcceptanceControlReceipt = z.infer<typeof AcceptanceControlReceiptSchema>;
+export const AcceptancePreviewCommandSchema = ScopeSchema.extend({ runId: z.string(), expectedGeneration: z.number().int().nonnegative(), operationId: z.string(), target: TargetSchema, presentation: z.literal("preview") });
+
+export const acceptanceContracts = {
+  getRun: defineContract({ channel: "acceptance:get-run", input: ScopeSchema.extend({ runId: z.string() }), output: AcceptanceRunSnapshotSchema.nullable() }),
+  getLatestRun: defineContract({ channel: "acceptance:get-latest-run", input: ScopeSchema, output: AcceptanceRunSnapshotSchema.nullable() }),
+  controlRun: defineContract({ channel: "acceptance:control-run", input: AcceptanceControlCommandSchema, output: AcceptanceControlReceiptSchema }),
+  getControlReceipt: defineContract({ channel: "acceptance:get-control-receipt", input: ScopeSchema.extend({ receiptId: z.string() }), output: AcceptanceControlReceiptSchema.nullable() }),
+  startPreview: defineContract({ channel: "acceptance:start-preview", input: AcceptancePreviewCommandSchema, output: AcceptancePreviewSessionSchema }),
+  getPreview: defineContract({ channel: "acceptance:get-preview", input: ScopeSchema.extend({ sessionId: z.string() }), output: AcceptancePreviewSessionSchema.nullable() }),
+  getAttestation: defineContract({ channel: "acceptance:get-attestation", input: ScopeSchema.extend({ attestationId: z.string() }), output: AcceptanceTestAttestationSchema.nullable() }),
+} as const;
+
+export const acceptanceEvents = {
+  runUpdated: defineEvent({ channel: "acceptance:run-updated", payload: AcceptanceRunSnapshotSchema }),
+  previewUpdated: defineEvent({ channel: "acceptance:preview-updated", payload: AcceptancePreviewSessionSchema }),
+  attestationUpdated: defineEvent({ channel: "acceptance:attestation-updated", payload: AcceptanceTestAttestationSchema }),
+} as const;
+export const acceptanceClient = createClient(acceptanceContracts);
+export const acceptanceEventClient = createEventClient(acceptanceEvents);
