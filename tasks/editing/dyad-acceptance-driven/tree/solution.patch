@@ -0,0 +1,72 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import type { IpcMainInvokeEvent } from "electron";
+import { and, eq } from "drizzle-orm";
+import { db } from "@/db";
+import { apps, chats } from "@/db/schema";
+import { getDyadAppPath } from "@/paths/paths";
+import { DyadError, DyadErrorKind } from "@/errors/dyad_error";
+import { broadcastToRegisteredWindows } from "@/ipc/utils/window_broadcast";
+import { createTypedHandler } from "./base";
+import { runAppTestsWithIsolation, normalizeRunTestFile } from "./tests_handlers";
+import { acceptanceContracts } from "../types/acceptance";
+import { acceptanceRevision, acceptanceTestFingerprint, createAttestation, createReceipt, createSession, digest, ensureAcceptanceRun, getAttestation, getReceipt, getRun, getSession, updateSession } from "../services/acceptance_store";
+
+async function owned(appId: number, chatId: number) {
+  const row = await db.select({ app: apps, chat: chats }).from(chats).innerJoin(apps, eq(chats.appId, apps.id)).where(and(eq(apps.id, appId), eq(chats.id, chatId))).get();
+  if (!row) throw new DyadError("Acceptance app/chat ownership check failed", DyadErrorKind.Auth);
+  return row.app;
+}
+function emit(event: IpcMainInvokeEvent, channel: string, payload: unknown): void { broadcastToRegisteredWindows(event.sender, channel, payload); }
+async function assertTarget(appPath: string, testFile: string): Promise<string> {
+  const normalized = normalizeRunTestFile(testFile); if (!normalized) throw new DyadError(`Invalid acceptance test target: ${testFile}`, DyadErrorKind.Validation);
+  const root = path.resolve(appPath); const target = path.resolve(root, normalized); if (!target.startsWith(`${root}${path.sep}`)) throw new DyadError("Acceptance target escapes app", DyadErrorKind.Auth);
+  const stat = await fs.lstat(target).catch(() => null); if (!stat?.isFile() || stat.isSymbolicLink()) throw new DyadError("Acceptance target must be a regular file", DyadErrorKind.Validation);
+  return normalized;
+}
+
+export async function registerAcceptanceRunForChat(appId: number, chatId: number, appPath: string) { return ensureAcceptanceRun(appId, chatId, appPath); }
+
+export function registerAcceptanceHandlers(): void {
+  createTypedHandler(acceptanceContracts.getLatestRun, async (_event, input) => getRun(input));
+  createTypedHandler(acceptanceContracts.getRun, async (_event, input) => getRun(input));
+  createTypedHandler(acceptanceContracts.getPreview, async (_event, input) => getSession(input));
+  createTypedHandler(acceptanceContracts.getAttestation, async (_event, input) => getAttestation(input));
+  createTypedHandler(acceptanceContracts.getControlReceipt, async (_event, input) => getReceipt(input));
+  createTypedHandler(acceptanceContracts.controlRun, async (_event, input) => {
+    await owned(input.appId, input.chatId); const run = await getRun(input); if (!run || run.runId !== input.runId) throw new DyadError("Acceptance run not found", DyadErrorKind.NotFound);
+    if (run.generation !== input.expectedGeneration) throw new DyadError("Stale Acceptance generation", DyadErrorKind.Conflict);
+    if (input.command === "freeze") { run.status = "frozen"; run.controlSequence += 1; }
+    if (input.command === "unfreeze") throw new DyadError("Acceptance freeze is immutable", DyadErrorKind.Precondition);
+    if (input.command === "cancel") { run.status = "cancelled"; run.controlSequence += 1; }
+    const receipt = await createReceipt({ appId: input.appId, chatId: input.chatId, runId: input.runId, operationId: input.operationId, command: input.command, generation: run.generation, controlSequence: run.controlSequence, status: run.status });
+    emit(_event, "acceptance:run-updated", run); return receipt;
+  });
+  createTypedHandler(acceptanceContracts.startPreview, async (event, input) => {
+    const app = await owned(input.appId, input.chatId); const run = await getRun(input); if (!run || run.runId !== input.runId) throw new DyadError("Acceptance run not found", DyadErrorKind.NotFound);
+    if (run.generation !== input.expectedGeneration) throw new DyadError("Stale Acceptance generation", DyadErrorKind.Conflict);
+    if (run.status === "frozen") throw new DyadError("Acceptance run is frozen", DyadErrorKind.Precondition);
+    const appPath = getDyadAppPath(app.path); const testFile = await assertTarget(appPath, input.target.testFile); const target = { testFile, grep: input.target.grep };
+    const startedRevision = await acceptanceRevision(appPath); const testFingerprint = await acceptanceTestFingerprint(appPath, testFile);
+    const session = await createSession({ appId: input.appId, chatId: input.chatId, runId: input.runId, generation: input.expectedGeneration, operationId: input.operationId, target, startedRevision, testFingerprint });
+    emit(event, "acceptance:preview-updated", session);
+    if (session.immutable) return session;
+    void (async () => {
+      try {
+        await updateSession(session.sessionId, { status: "setup" }); emit(event, "acceptance:preview-updated", await getSession(inputWithSession(input, session.sessionId)));
+        await updateSession(session.sessionId, { status: "running" }); emit(event, "acceptance:preview-updated", await getSession(inputWithSession(input, session.sessionId)));
+        const result = await runAppTestsWithIsolation({ event, appId: input.appId, testFile, grep: input.target.grep ?? undefined, source: "acceptance" });
+        const currentFingerprint = await acceptanceTestFingerprint(appPath, testFile);
+        const finishedRevision = await acceptanceRevision(appPath);
+        const status = result.infraError?.message.toLowerCase().includes("abort") ? "cancelled" : currentFingerprint !== testFingerprint || finishedRevision !== startedRevision ? "invalidated" : result.infraError ? "infrastructure" : result.results.length > 0 && result.results.every((x) => x.status === "passed") ? "passed" : "failed";
+        const attestation = await createAttestation({ schemaVersion: 1, runId: input.runId, sessionId: session.sessionId, appId: input.appId, chatId: input.chatId, generation: input.expectedGeneration, startedRevision, finishedRevision, testFingerprint, outcome: status, resultDigest: digest(result), completedSequence: (await getSession(inputWithSession(input, session.sessionId)))?.sequence ?? 1 });
+        const updated = await updateSession(session.sessionId, { status, finishedRevision, attestationId: attestation.attestationId }); emit(event, "acceptance:preview-updated", updated); emit(event, "acceptance:attestation-updated", attestation);
+      } catch (error) {
+        const finishedRevision = await acceptanceRevision(appPath).catch(() => startedRevision); const attestation = await createAttestation({ schemaVersion: 1, runId: input.runId, sessionId: session.sessionId, appId: input.appId, chatId: input.chatId, generation: input.expectedGeneration, startedRevision, finishedRevision, testFingerprint, outcome: "infrastructure", resultDigest: digest({ error: String(error) }), completedSequence: 1 });
+        const updated = await updateSession(session.sessionId, { status: "infrastructure", finishedRevision, attestationId: attestation.attestationId }); emit(event, "acceptance:preview-updated", updated); emit(event, "acceptance:attestation-updated", attestation);
+      }
+    })();
+    return session;
+  });
+}
+function inputWithSession(input: { appId: number; chatId: number }, sessionId: string) { return { ...input, sessionId }; }
