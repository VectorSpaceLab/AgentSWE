{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "protocol", "runtime"],
  "properties": {
    "schema_version": {"const": "agentswe-broker-stats-v1"},
    "protocol": {"type": "object", "required": ["model", "reasoning_effort", "transport"]},
    "runtime": {"type": "object", "required": ["calls", "failures", "successful_calls", "input_tokens", "output_tokens", "total_tokens"]}
  },
  "additionalProperties": false
}
