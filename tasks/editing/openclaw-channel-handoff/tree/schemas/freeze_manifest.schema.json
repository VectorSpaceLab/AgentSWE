{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_kind",
    "public_case_inventory",
    "hidden_case_inventory",
    "accepted_candidate_digests",
    "accepted_submission_count",
    "candidate_digest",
    "source_submission",
    "source_submission_id",
    "latest_submitted_at",
    "latest_dev_completed_at",
    "latest_feedback_at",
    "feedback_digest",
    "feedback_consumed",
    "feedback_chain_complete",
    "freeze_reason",
    "max_dev_rounds",
    "n_concurrent",
    "dev_passed_is_automatic_freeze",
    "frozen_at",
    "frozen_tree_read_only",
    "hidden_allowed",
    "dev_evaluated",
    "credential_mounted_to_candidate",
    "hidden_started_at",
    "hidden_completed_at",
    "hidden_attestation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "openclaw-agentloop-freeze-v3"},
    "evidence_kind": {"enum": ["formal", "pilot", "probe"]},
    "public_case_inventory": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"enum": ["dev_001", "dev_002"]}},
    "hidden_case_inventory": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"pattern": "^test_00[1-6]$"}},
    "accepted_candidate_digests": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "accepted_submission_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_submission": {"type": "integer", "minimum": 1, "maximum": 10},
    "source_submission_id": {"type": "string", "pattern": "^candidate-(00[1-9]|010)$"},
    "latest_submitted_at": {"type": "string", "format": "date-time"},
    "latest_dev_completed_at": {"type": "string", "format": "date-time"},
    "latest_feedback_at": {"type": "string", "format": "date-time"},
    "feedback_digest": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "feedback_consumed": {"const": true},
    "feedback_chain_complete": {"const": true},
    "freeze_reason": {"enum": ["max_dev_rounds", "builder_exit"]},
    "max_dev_rounds": {"type": "integer", "minimum": 1, "maximum": 10},
    "n_concurrent": {"const": 1},
    "dev_passed_is_automatic_freeze": {"const": false},
    "frozen_at": {"type": "string", "format": "date-time"},
    "frozen_tree_read_only": {"const": true},
    "hidden_allowed": {"const": true},
    "dev_evaluated": {"const": true},
    "credential_mounted_to_candidate": {"const": false},
    "hidden_started_at": {"type": ["string", "null"], "format": "date-time"},
    "hidden_completed_at": {"type": ["string", "null"], "format": "date-time"},
    "hidden_attestation": {"type": ["string", "null"]}
  }
}
