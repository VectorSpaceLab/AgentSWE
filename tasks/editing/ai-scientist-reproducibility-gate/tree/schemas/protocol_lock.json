{
  "schema_version": 1,
  "protocol": "edit-agentloop-v1",
  "builder_model": "gpt-5.6-sol",
  "builder_reasoning_effort": "xhigh",
  "lower_model": "gpt-5.6-sol",
  "lower_reasoning_effort": "medium",
  "candidate_credential": "placeholder-only",
  "broker_owner": "evaluator",
  "public_cases": ["dev_001", "dev_002"],
  "hidden_cases": ["test_001", "test_002", "test_003", "test_004", "test_005", "test_006"],
  "accepted_submission_range": {"minimum": 1, "maximum": 10},
  "accepted_ledger": "dev_lifecycle.json.records",
  "lifecycle": [
    "accepted_candidate_1..10",
    "dev_001+dev_002_after_each_acceptance",
    "fresh_feedback_after_each_accepted_submission",
    "freeze_latest_after_builder_exit_or_max_dev_rounds",
    "hidden_after_freeze"
  ],
  "latest_freeze_binding": "latest_accepted_submission",
  "hidden_requires_freeze": true,
  "dev_passed_is_automatic_freeze": false,
  "result_and_code_are_independent": true
}
