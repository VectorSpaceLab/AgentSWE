{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Scientist generalized accepted-submission freeze manifest",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_kind",
    "public_case_inventory",
    "hidden_case_inventory",
    "source_submission",
    "source_submission_id",
    "accepted_submission_count",
    "accepted_candidate_digests",
    "freeze_reason",
    "max_dev_rounds",
    "n_concurrent",
    "dev_passed_is_automatic_freeze",
    "candidate_delivery_digest",
    "candidate_materialized_digest",
    "candidate_digest",
    "patch_sha256",
    "frozen_candidate_path",
    "frozen_at",
    "frozen_tree_read_only",
    "frozen_tree_regular",
    "hidden_allowed",
    "dev_gate",
    "feedback_digest",
    "feedback_digest_ack",
    "feedback_consumed",
    "feedback_chain_complete",
    "dev_evaluated",
    "credential_mounted_to_candidate"
  ],
  "properties": {
    "schema_version": {"const": "agentswe-ai-scientist-freeze-manifest-v2"},
    "evidence_kind": {"enum": ["formal", "pilot", "smoke"]},
    "public_case_inventory": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hidden_case_inventory": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_submission": {"type": "integer", "minimum": 1, "maximum": 10},
    "source_submission_id": {"type": "string", "pattern": "^candidate-[0-9]{3}$"},
    "accepted_submission_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "accepted_candidate_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "freeze_reason": {"enum": ["max_dev_rounds", "builder_exit"]},
    "max_dev_rounds": {"type": "integer", "minimum": 1, "maximum": 10},
    "n_concurrent": {"const": 1},
    "dev_passed_is_automatic_freeze": {"const": false},
    "candidate_delivery_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_materialized_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen_candidate_path": {"type": "string", "minLength": 1},
    "frozen_at": {"type": "string", "format": "date-time"},
    "frozen_tree_read_only": {"const": true},
    "frozen_tree_regular": {"const": true},
    "hidden_allowed": {"const": true},
    "dev_gate": {
      "type": "object",
      "required": ["latest_dev_passed", "record_only"],
      "properties": {
        "latest_dev_passed": {"type": "boolean"},
        "record_only": {"const": true}
      },
      "additionalProperties": false
    },
    "feedback_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feedback_digest_ack": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "feedback_consumed": {"const": true},
    "feedback_chain_complete": {"const": true},
    "dev_evaluated": {"const": true},
    "credential_mounted_to_candidate": {"const": false}
  },
  "additionalProperties": true
}
