{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source_submission",
    "source_submission_id",
    "accepted_submission_count",
    "max_dev_rounds",
    "accepted_candidate_digests",
    "candidate_digest",
    "candidate_root",
    "builder_session_id",
    "builder_connection_id",
    "feedback_digest",
    "feedback_consumed",
    "feedback_chain_complete",
    "freeze_reason",
    "hidden_gate",
    "frozen_at",
    "hidden_allowed",
    "dev_evaluated",
    "immutable_candidate",
    "frozen_tree_read_only",
    "frozen_tree_regular",
    "credential_mounted_to_candidate",
    "hidden_case_inventory",
    "pilot_not_formal"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "agentswe-edit-freeze-manifest/v2"},
    "source_submission": {"type": "integer", "minimum": 1, "maximum": 10},
    "source_submission_id": {"type": "string", "minLength": 1},
    "accepted_submission_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "max_dev_rounds": {"type": "integer", "minimum": 1, "maximum": 10},
    "accepted_candidate_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_root": {"type": "string", "minLength": 1},
    "builder_session_id": {"type": "string", "minLength": 1},
    "builder_connection_id": {"type": "string", "minLength": 1},
    "feedback_digest": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "feedback_consumed": {"const": true},
    "feedback_chain_complete": {"const": true},
    "freeze_reason": {"enum": ["builder_exit", "max_dev_rounds", "controller_cli_complete"]},
    "hidden_gate": {"const": "issued-after-freeze"},
    "frozen_at": {"type": "string", "minLength": 1},
    "hidden_allowed": {"const": true},
    "dev_evaluated": {"const": true},
    "immutable_candidate": {"const": true},
    "frozen_tree_read_only": {"const": true},
    "frozen_tree_regular": {"const": true},
    "credential_mounted_to_candidate": {"const": false},
    "hidden_case_inventory": {
      "const": ["test_001", "test_002", "test_003", "test_004", "test_005", "test_006"]
    },
    "pilot_not_formal": {"type": "boolean"}
  }
}
