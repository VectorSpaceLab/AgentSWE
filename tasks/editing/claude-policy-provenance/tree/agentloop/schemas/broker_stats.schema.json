{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "protocol", "runtime", "upstream", "credential"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "agentswe-broker-stats/v1"},
    "protocol": {
      "type": "object",
      "required": ["model", "reasoning_effort"],
      "additionalProperties": false,
      "properties": {"model": {"const": "deepseek-flash"}, "reasoning_effort": {"const": "medium"}}
    },
    "runtime": {
      "type": "object",
      "required": ["calls", "failures", "successful_calls", "broker_failures", "provider_failures", "credential_failures", "protocol_failures", "input_tokens", "output_tokens", "total_tokens"],
      "additionalProperties": false,
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "successful_calls": {"type": "integer", "minimum": 0},
        "broker_failures": {"type": "integer", "minimum": 0},
        "provider_failures": {"type": "integer", "minimum": 0},
        "credential_failures": {"type": "integer", "minimum": 0},
        "protocol_failures": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "upstream": {
      "type": "object",
      "required": ["status_counts"],
      "additionalProperties": false,
      "properties": {"status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}
    },
    "credential": {
      "type": "object",
      "required": ["candidate_visible", "provider_secret_logged", "credential_value_recorded"],
      "additionalProperties": false,
      "properties": {
        "candidate_visible": {"const": "broker-only-placeholder"},
        "provider_secret_logged": {"const": false},
        "credential_value_recorded": {"const": false}
      }
    }
  }
}
