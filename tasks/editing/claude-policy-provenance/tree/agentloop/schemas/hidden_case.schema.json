{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "runtime_nonce",
    "task",
    "case_contract_digest",
    "allowed_actions"
  ],
  "properties": {
    "schema_version": {"const": "agentswe-claude-issued-case/v2"},
    "case_id": {"enum": ["test_001", "test_002", "test_003", "test_004", "test_005", "test_006"]},
    "runtime_nonce": {"type": "string", "minLength": 16},
    "task": {"type": "string", "minLength": 1},
    "case_contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 96},
          "type": {"enum": ["hook_event", "inspector_command"]},
          "event": {"type": "object"},
          "argv": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}}
        }
      }
    }
  }
}
