{
    "schema_version": 2,
    "policy_id": "compat-reserved",
    "policy_epoch": 1,
    "previous_policy_snapshot_digest": null,
    "revision": "compat-reserved-v1",
    "mode": "enforce",
    "default_decision": "deny",
    "tools": {
        "Write": "allow",
        "Read": "allow"
    },
    "paths": {
        "allow": [
            "src/**"
        ],
        "deny": [
            ".env"
        ]
    },
    "commands": {
        "allow": [],
        "deny": [],
        "audit_only": [],
        "rewrites": []
    },
    "network": {
        "allow_hosts": [],
        "deny_hosts": []
    },
    "mcp": {},
    "reservation": {
        "max_inflight": 1,
        "max_session_inflight": 1,
        "lease_seconds": 3,
        "reclaim_expired": true
    },
    "approval": {
        "threshold": 2,
        "ticket_seconds": 4,
        "principals": ["compat-a", "compat-b", "compat-c"],
        "tools": ["Write"],
        "principal_groups": {"compat-a":"release", "compat-b":"security", "compat-c":"release"},
        "required_groups": ["release", "security"]
    },
    "ownership": {"handoff_seconds": 5, "allowed_targets": ["compat-recovery", "compat-spare"]},
    "delivery": {"claim_seconds": 3, "max_pending": 8, "require_completion": true},
    "repair": {"max_quarantine_bytes": 1048576, "required_verifiers": 2, "verifiers": ["compat-repair-a", "compat-repair-b"]},
    "continuation": {"token_seconds": 4, "max_pending": 2, "tools": ["Write", "Read"]}
}
