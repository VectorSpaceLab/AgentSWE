{
    "schema_version": 2,
    "policy_id": "hidden-epoch",
    "policy_epoch": 70,
    "previous_policy_snapshot_digest": null,
    "revision": "snapshot-allow-v1",
    "mode": "enforce",
    "default_decision": "deny",
    "tools": {
        "Read": "allow",
        "Bash": "allow"
    },
    "paths": {
        "allow": [
            "src/**"
        ],
        "deny": [
            ".env"
        ]
    },
    "commands": {
        "allow": [
            "pytest"
        ],
        "deny": [],
        "audit_only": [],
        "rewrites": []
    },
    "network": {
        "allow_hosts": [],
        "deny_hosts": []
    },
    "mcp": {},
    "reservation": {
        "max_inflight": 1,
        "max_session_inflight": 1,
        "lease_seconds": 3,
        "reclaim_expired": true
    },
    "approval": {
        "threshold": 2,
        "ticket_seconds": 4,
        "principals": ["epoch-a", "epoch-b", "epoch-c"],
        "tools": ["Bash"],
        "principal_groups": {"epoch-a":"release", "epoch-b":"security", "epoch-c":"release"},
        "required_groups": ["release", "security"]
    },
    "ownership": {"handoff_seconds": 5, "allowed_targets": ["epoch-branch-a", "epoch-branch-b", "epoch-recovery"]},
    "delivery": {"claim_seconds": 3, "max_pending": 10, "require_completion": true},
    "repair": {"max_quarantine_bytes": 1048576, "required_verifiers": 2, "verifiers": ["epoch-repair-a", "epoch-repair-b"]},
    "continuation": {"token_seconds": 4, "max_pending": 2, "tools": ["Read", "Bash"]}
}
