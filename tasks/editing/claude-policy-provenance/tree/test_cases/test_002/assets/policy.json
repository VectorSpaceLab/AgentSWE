{
    "schema_version": 2,
    "policy_id": "hidden-transaction",
    "policy_epoch": 3,
    "previous_policy_snapshot_digest": null,
    "revision": "transaction-v2",
    "mode": "enforce",
    "default_decision": "deny",
    "tools": {
        "Write": "allow"
    },
    "paths": {
        "allow": [
            "src/**",
            "tmp/**"
        ],
        "deny": [
            ".env",
            "secrets/**"
        ]
    },
    "commands": {
        "allow": [],
        "deny": [],
        "audit_only": [],
        "rewrites": []
    },
    "network": {
        "allow_hosts": [],
        "deny_hosts": []
    },
    "mcp": {},
    "reservation": {
        "max_inflight": 1,
        "max_session_inflight": 1,
        "lease_seconds": 3,
        "reclaim_expired": true
    },
    "approval": {
        "threshold": 2,
        "ticket_seconds": 4,
        "principals": ["txn-a", "txn-b", "txn-c"],
        "tools": ["Write"],
        "principal_groups": {"txn-a":"release", "txn-b":"security", "txn-c":"release"},
        "required_groups": ["release", "security"]
    },
    "ownership": {"handoff_seconds": 5, "allowed_targets": ["txn-branch-a", "txn-branch-b", "txn-recovery"]},
    "delivery": {"claim_seconds": 3, "max_pending": 8, "require_completion": true},
    "repair": {"max_quarantine_bytes": 1048576, "required_verifiers": 2, "verifiers": ["txn-repair-a", "txn-repair-b"]},
    "continuation": {"token_seconds": 4, "max_pending": 1, "tools": ["Write"]}
}
