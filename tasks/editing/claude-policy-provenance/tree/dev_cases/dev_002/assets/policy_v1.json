{
  "schema_version": 2,
  "policy_id": "public-reload",
  "policy_epoch": 10,
  "previous_policy_snapshot_digest": null,
  "revision": "public-reload-v1",
  "mode": "enforce",
  "default_decision": "deny",
  "tools": {"Bash": "allow"},
  "paths": {"allow": ["**"], "deny": []},
  "commands": {
    "allow": ["pwd", "printf", "curl"],
    "deny": [],
    "audit_only": ["pwd"],
    "rewrites": [{"command":"curl https://example.test/status","replacement":"printf offline-status"}]
  },
  "network": {"allow_hosts": ["example.test"], "deny_hosts": []},
  "mcp": {},
  "reservation": {"max_inflight": 2, "max_session_inflight": 1, "lease_seconds": 2, "reclaim_expired": true},
  "approval": {"threshold": 2, "ticket_seconds": 5, "principals": ["public-a", "public-b", "public-c"], "tools": ["Write"], "principal_groups": {"public-a":"release", "public-b":"security", "public-c":"release"}, "required_groups": ["release", "security"]},
  "ownership": {"handoff_seconds": 5, "allowed_targets": ["public-branch-a", "public-branch-b", "public-recovery-two"]},
  "delivery": {"claim_seconds": 3, "max_pending": 24, "require_completion": true},
  "repair": {"max_quarantine_bytes": 1048576, "required_verifiers": 2, "verifiers": ["public-repair-a", "public-repair-b"]},
  "continuation": {"token_seconds": 5, "max_pending": 2, "tools": ["Bash"]}
}
