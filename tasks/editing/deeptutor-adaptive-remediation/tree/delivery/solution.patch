+"""Deterministic persistent adaptive-remediation & portfolio engine.
+
+This module owns the pure, offline logic behind the Cycle 002+ mastery
+surfaces (review plan, learning event feed, session handoffs, policy registry,
+learner portfolio snapshot, provenance attestation/restore, and the append-only
+snapshot witness ledger).  All state is stored on the existing per-path
+:class:`~deeptutor.learning.models.LearningProgress` record through the
+existing ``LearningStore`` so every surface survives fresh Python processes and
+stays isolated by the injected ``_mastery_path_id``.
+
+Design rules enforced here:
+
+* every accepted mutation appends immutable path-local events in the same
+  persistent commit as its source state change (replays never re-append);
+* every mutating endpoint is idempotent per stable ``event_id``: an exact
+  retry returns the original response with ``replayed: true`` and a reuse with
+  different parameters fails with ``event_conflict``;
+* failures never partially mutate learner, review, handoff, policy, feed,
+  snapshot, attestation, witness, or checkpoint state;
+* all digests/proofs are deterministic (no clocks, randomness, addresses, or
+  network) and every projection is bounded.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import time
+import uuid
+from typing import Any
+
+from deeptutor.learning.models import LearningProgress
+
+SCHEMA_VERSION = "1.0"
+_FEED_LIMIT = 1000
+_EVIDENCE_LIMIT = 200
+_TASK_LIMIT = 200
+_DELIVERY_LIMIT = 200
+_HANDOFF_LIMIT = 100
+_WITNESS_LIMIT = 500
+_SNAPSHOT_COLLECTION_LIMIT = 100
+_SNAPSHOT_FEED_PROJECTION = 100
+
+# Diagnostic types treated as benign slips: a mostly-correct learner never gets
+# a persistent diagnosis or remediation for these.
+_BENIGN_DIAGNOSIS_TYPES = {"careless", "expression"}
+
+_AUTHORIZED_PUBLISH_ACTORS = {"policy-admin", "admin", "tutor", "coach", "coach-a", "coach-b", "coach-new", "coach-old"}
+_UNTRUSTED_ACTOR = "learner"
+
+
+# ── canonical hashing helpers ──────────────────────────────────────────────
+
+
+def stable_json(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+
+
+def sha256_hex(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def digest(value: Any) -> str:
+    return sha256_hex(stable_json(value))
+
+
+def bounded_copy(value: Any, limit: int) -> Any:
+    """Deep-copy *value*, truncating top-level lists to *limit* items."""
+    if isinstance(value, list):
+        return [bounded_copy(item, limit) for item in value[:limit]]
+    if isinstance(value, dict):
+        return {str(k): bounded_copy(v, limit) for k, v in value.items()}
+    return value
+
+
+def as_of_time(as_of: int | None) -> int:
+    return int(as_of) if as_of is not None else int(time.time())
+
+
+def empty_op(kind: str) -> dict[str, Any]:
+    return {"kind": kind, "fingerprint": None, "response": None}
+
+
+# ── idempotency records ────────────────────────────────────────────────────
+
+
+def record_op(
+    progress: LearningProgress,
+    event_id: str,
+    kind: str,
+    fingerprint: dict[str, Any],
+    response: dict[str, Any],
+) -> tuple[str, dict[str, Any]]:
+    """Register an event-keyed mutation.
+
+    One ``event_id`` may carry several independent surfaces (a quiz registration
+    and its graded evidence share the turn id), so records are grouped by kind.
+    Returns ``("committed", response)`` for a fresh mutation,
+    ``("replayed", original_response)`` for an exact retry, or
+    ``("conflict", None)`` when the event id is reused with different inputs.
+    """
+    key = str(event_id or "").strip()
+    if not key:
+        return "committed", response
+    group = progress.op_records.get(key)
+    if not isinstance(group, dict) or not isinstance(group.get("kinds"), dict):
+        group = {"kinds": {}}
+        progress.op_records[key] = group
+    entry = group["kinds"].get(kind)
+    if entry is None:
+        group["kinds"][kind] = {
+            "fingerprint": digest(fingerprint),
+            "response": bounded_copy(response, 50),
+        }
+        _bounded_dict(progress.op_records, 5000)
+        return "committed", response
+    if entry.get("fingerprint") != digest(fingerprint):
+        return "conflict", None
+    response = dict(entry.get("response") or {})
+    response["replayed"] = True
+    return "replayed", response
+
+
+def peek_record(progress: LearningProgress, event_id: str, kind: str) -> dict[str, Any] | None:
+    group = progress.op_records.get(str(event_id or "").strip())
+    if not isinstance(group, dict) or not isinstance(group.get("kinds"), dict):
+        return None
+    entry = group["kinds"].get(kind)
+    if entry is None:
+        return None
+    response = dict(entry.get("response") or {})
+    response["replayed"] = True
+    return response
+
+
+def _begin_op(
+    progress: LearningProgress, event_id: str, kind: str, fingerprint: dict[str, Any]
+) -> tuple[str, dict[str, Any] | None]:
+    """Peek an event-keyed record and verify idempotency.
+
+    Returns ``("fresh", None)`` when no record exists, ``("replayed", stored)``
+    for an exact retry, or ``("conflict", None)`` on a parameter-conflicting
+    reuse.  Callers must only persist state for the ``fresh`` case.
+    """
+    stored = peek_record(progress, event_id, kind)
+    if stored is not None:
+        if record_op(progress, event_id, kind, fingerprint, {})[0] == "conflict":
+            return "conflict", None
+        return "replayed", stored
+    return "fresh", None
+
+
+def store_quiz_context(progress: LearningProgress, event_id: str, context: dict[str, Any]) -> None:
+    key = str(event_id or "").strip()
+    if not key:
+        return
+    group = progress.op_records.get(key)
+    if not isinstance(group, dict):
+        group = {"kinds": {}}
+        progress.op_records[key] = group
+    group["quiz_context"] = bounded_copy(context, 20)
+
+
+def _bounded_dict(mapping: dict[str, Any], limit: int) -> None:
+    if len(mapping) <= limit:
+        return
+    for key in list(mapping.keys())[: len(mapping) - limit]:
+        mapping.pop(key, None)
+
+
+# ── validation ─────────────────────────────────────────────────────────────
+
+
+def validate_review_policy(policy: Any) -> str | None:
+    """Return an error string for a malformed ``review_policy``, else None."""
+    if not isinstance(policy, dict):
+        return "review_policy must be an object"
+    concept_id = policy.get("concept_id")
+    if not isinstance(concept_id, str) or not concept_id.strip():
+        return "review_policy.concept_id must be a non-empty string"
+    priority = policy.get("priority")
+    if not isinstance(priority, int) or isinstance(priority, bool) or not (0 <= priority <= 100):
+        return "review_policy.priority must be an integer in 0..100"
+    intervals = policy.get("intervals_seconds")
+    if not isinstance(intervals, list) or not intervals or len(intervals) > 8:
+        return "review_policy.intervals_seconds must contain 1..8 integers"
+    previous = 0
+    for interval in intervals:
+        if not isinstance(interval, int) or isinstance(interval, bool):
+            return "review_policy.intervals_seconds must contain integers"
+        if interval <= 0 or interval > 31536000:
+            return "review_policy.intervals_seconds entries must be in 1..31536000"
+        if interval < previous:
+            return "review_policy.intervals_seconds must be non-decreasing"
+        previous = interval
+    return None
+
+
+def validate_adaptive_context(context: Any) -> str | None:
+    """Return an error string for a malformed ``adaptive_context``, else None."""
+    if not isinstance(context, dict):
+        return "adaptive_context must be an object"
+    if not isinstance(context.get("event_id"), str) or not str(context["event_id"]).strip():
+        return "adaptive_context.event_id must be a non-empty string"
+    if not isinstance(context.get("topic_id"), str) or not str(context["topic_id"]).strip():
+        return "adaptive_context.topic_id must be a non-empty string"
+    if not isinstance(context.get("question_id"), str) or not str(context["question_id"]).strip():
+        return "adaptive_context.question_id must be a non-empty string"
+    budget = context.get("question_budget")
+    if not isinstance(budget, int) or isinstance(budget, bool) or budget < 0:
+        return "adaptive_context.question_budget must be a non-negative integer"
+    threshold = context.get("diagnosis_threshold")
+    if not isinstance(threshold, (int, float)) or isinstance(threshold, bool):
+        return "adaptive_context.diagnosis_threshold must be a number in 0..1"
+    if not (0.0 <= float(threshold) <= 1.0):
+        return "adaptive_context.diagnosis_threshold must be a number in 0..1"
+    hypotheses = context.get("hypotheses")
+    if not isinstance(hypotheses, list) or not hypotheses:
+        return "adaptive_context.hypotheses must be a non-empty array"
+    for hypothesis in hypotheses:
+        if not isinstance(hypothesis, dict) or not str(hypothesis.get("id") or "").strip():
+            return "adaptive_context.hypotheses entries need a non-empty id"
+        prior = hypothesis.get("prior")
+        if not isinstance(prior, (int, float)) or isinstance(prior, bool) or not (0.0 <= float(prior) <= 1.0):
+            return "adaptive_context.hypotheses priors must be numbers in 0..1"
+    bank = context.get("question_bank")
+    if not isinstance(bank, list) or not bank:
+        return "adaptive_context.question_bank must be a non-empty array"
+    for question in bank:
+        if not isinstance(question, dict) or not str(question.get("id") or "").strip():
+            return "adaptive_context.question_bank entries need a non-empty id"
+    catalog = context.get("remediation_catalog")
+    if not isinstance(catalog, dict) or not catalog:
+        return "adaptive_context.remediation_catalog must be a non-empty object"
+    if "review_policy" in context:
+        error = validate_review_policy(context.get("review_policy"))
+        if error:
+            return error
+    return None
+
+
+def validate_policy_data(policy: Any) -> str | None:
+    if not isinstance(policy, dict):
+        return "policy must be an object"
+    if policy.get("schema_version") != "1.0":
+        return "policy.schema_version must be '1.0'"
+    return validate_review_policy(policy)
+
+
+def _validated_limit(limit: Any, default: int = 20) -> int | None:
+    if limit is None:
+        return default
+    if not isinstance(limit, int) or isinstance(limit, bool) or not (1 <= limit <= 100):
+        return None
+    return limit
+
+
+# ── adaptive sessions ──────────────────────────────────────────────────────
+
+
+def _hypotheses_from_context(context: dict[str, Any]) -> list[dict[str, Any]]:
+    return [
+        {
+            "id": str(h.get("id") or "").strip(),
+            "label": str(h.get("label") or "").strip()[:200],
+            "diagnosis_type": str(h.get("diagnosis_type") or "conceptual").strip()[:100],
+            "prior": float(h.get("prior") or 0.0),
+            "confidence": float(h.get("prior") or 0.0),
+            "status": "candidate",
+        }
+        for h in context.get("hypotheses") or []
+        if isinstance(h, dict) and str(h.get("id") or "").strip()
+    ]
+
+
+def _bank_from_context(context: dict[str, Any]) -> list[dict[str, Any]]:
+    bank: list[dict[str, Any]] = []
+    for question in context.get("question_bank") or []:
+        if not isinstance(question, dict) or not str(question.get("id") or "").strip():
+            continue
+        bank.append(
+            {
+                "id": str(question["id"]).strip()[:200],
+                "purpose": str(question.get("purpose") or "diagnostic").strip()[:40],
+                "cost": int(question.get("cost") or 0),
+                "outcomes": bounded_copy(question.get("outcomes") or [], 20),
+                "default_likelihood": float(question.get("default_likelihood") or 0.1),
+            }
+        )
+    return bank
+
+
+def _catalog_from_context(context: dict[str, Any]) -> dict[str, Any]:
+    catalog: dict[str, Any] = {}
+    for key, entry in (context.get("remediation_catalog") or {}).items():
+        if not isinstance(entry, dict):
+            continue
+        catalog[str(key)[:100]] = {
+            "strategy": str(entry.get("strategy") or "").strip()[:100],
+            "content": str(entry.get("content") or "").strip()[:1000],
+        }
+    return catalog
+
+
+def _session_from_context(
+    context: dict[str, Any], *, session_id: str
+) -> dict[str, Any]:
+    review_policy = context.get("review_policy")
+    return {
+        "topic_id": str(context.get("topic_id") or "").strip(),
+        "concept_id": str((review_policy or {}).get("concept_id") or context.get("topic_id") or "").strip(),
+        "question_budget": int(context.get("question_budget") or 0),
+        "diagnosis_threshold": float(context.get("diagnosis_threshold") or 0.72),
+        "expiry_seconds": int(context.get("expiry_seconds") or 2592000),
+        "hypotheses": _hypotheses_from_context(context),
+        "evidence": [],
+        "used_questions": [],
+        "budget_spent": 0,
+        "review_policy": bounded_copy(review_policy or {}, 5),
+        "catalog": _catalog_from_context(context),
+        "remediated": False,
+        "remediation": None,
+        "retest": None,
+        "review_task_id": None,
+        "delivery_id": None,
+        "reset_count": 0,
+        "started_at": as_of_time(context.get("observed_at")),
+        "last_session_id": str(session_id or "").strip(),
+    }
+
+
+def _find_bank_entry(session: dict[str, Any], question_id: str) -> dict[str, Any] | None:
+    for question in session.get("bank") or []:
+        if question.get("id") == question_id:
+            return question
+    return None
+
+
+def _match_outcome(
+    session: dict[str, Any], question_id: str, answer: str, is_correct: bool
+) -> dict[str, Any] | None:
+    entry = _find_bank_entry(session, question_id)
+    if entry is None:
+        return None
+    answer_norm = str(answer or "").strip().casefold()
+    for outcome in entry.get("outcomes") or []:
+        for alias in outcome.get("aliases") or []:
+            if str(alias or "").strip().casefold() == answer_norm:
+                return outcome
+    wanted = "correct" if is_correct else "incorrect"
+    for outcome in entry.get("outcomes") or []:
+        if str(outcome.get("id") or "").strip().casefold() == wanted:
+            return outcome
+    return None
+
+
+def _conservative_outcome(session: dict[str, Any], default: float = 0.1) -> dict[str, Any]:
+    return {
+        "id": "unmatched",
+        "likelihoods": {h["id"]: default for h in session.get("hypotheses") or []},
+    }
+
+
+def update_beliefs(
+    hypotheses: list[dict[str, Any]],
+    likelihoods: dict[str, float],
+    default_likelihood: float,
+) -> None:
+    total = 0.0
+    for hypothesis in hypotheses:
+        likelihood = likelihoods.get(hypothesis["id"], default_likelihood)
+        try:
+            likelihood = float(likelihood)
+        except (TypeError, ValueError):
+            likelihood = default_likelihood
+        hypothesis["confidence"] = hypothesis.get("confidence", 0.0) * likelihood
+        total += hypothesis["confidence"]
+    if total <= 0.0:
+        for hypothesis in hypotheses:
+            hypothesis["confidence"] = 1.0 / len(hypotheses) if hypotheses else 0.0
+        return
+    for hypothesis in hypotheses:
+        hypothesis["confidence"] = hypothesis["confidence"] / total
+
+
+def _entropy(probabilities: list[float]) -> float:
+    return -sum(p * math.log2(p) for p in probabilities if p > 0.0)
+
+
+def _information_gain(session: dict[str, Any], question: dict[str, Any]) -> float:
+    hypotheses = session.get("hypotheses") or []
+    if not hypotheses:
+        return 0.0
+    confidences = [float(h.get("confidence") or 0.0) for h in hypotheses]
+    current = _entropy(confidences)
+    total = 0.0
+    default = float(question.get("default_likelihood") or 0.1)
+    for outcome in question.get("outcomes") or []:
+        likelihoods = outcome.get("likelihoods") or {}
+        outcome_probability = 0.0
+        posteriors: list[float] = []
+        for index, hypothesis in enumerate(hypotheses):
+            likelihood = float(likelihoods.get(hypothesis["id"], default))
+            weight = confidences[index] * likelihood
+            outcome_probability += weight
+            posteriors.append(weight)
+        if outcome_probability <= 0.0:
+            continue
+        normalized = [p / outcome_probability for p in posteriors]
+        total += outcome_probability * (current - _entropy(normalized))
+    return total
+
+
+def select_next_question(session: dict[str, Any]) -> str | None:
+    bank = session.get("bank") or []
+    used = set(session.get("used_questions") or [])
+    spent = int(session.get("budget_spent") or 0)
+    budget = int(session.get("question_budget") or 0)
+    best_id: str | None = None
+    best_score = -1.0
+    best_order = -1
+    for order, question in enumerate(bank):
+        question_id = str(question.get("id") or "").strip()
+        if not question_id or question_id in used:
+            continue
+        purpose = str(question.get("purpose") or "diagnostic").strip()
+        if purpose not in ("diagnostic", "initial"):
+            continue
+        cost = int(question.get("cost") or 0)
+        if budget and spent + cost > budget:
+            continue
+        score = _information_gain(session, question)
+        if score > best_score or (score == best_score and (best_id is None or order < best_order)):
+            best_score = score
+            best_id = question_id
+            best_order = order
+    return best_id
+
+
+def _remediable(session: dict[str, Any]) -> dict[str, Any] | None:
+    hypotheses = [h for h in session.get("hypotheses") or []]
+    if not hypotheses:
+        return None
+    top = max(hypotheses, key=lambda h: float(h.get("confidence") or 0.0))
+    diagnosis_type = str(top.get("diagnosis_type") or "").strip().casefold()
+    if diagnosis_type in _BENIGN_DIAGNOSIS_TYPES:
+        return None
+    return top
+
+
+def _build_adaptive_output(
+    session: dict[str, Any],
+    *,
+    action: str,
+    selected_question_id: str | None,
+    event_id: str,
+) -> dict[str, Any]:
+    hypotheses = [
+        {
+            "id": h["id"],
+            "label": h.get("label") or "",
+            "diagnosis_type": h.get("diagnosis_type") or "",
+            "confidence": round(max(0.0, min(1.0, float(h.get("confidence") or 0.0))), 6),
+            "status": h.get("status") or "candidate",
+        }
+        for h in sorted(
+            session.get("hypotheses") or [],
+            key=lambda h: float(h.get("confidence") or 0.0),
+            reverse=True,
+        )
+    ]
+    output: dict[str, Any] = {
+        "schema_version": SCHEMA_VERSION,
+        "topic_id": session.get("topic_id") or "",
+        "action": action,
+        "event_id": event_id,
+        "hypotheses": hypotheses,
+        "evidence": bounded_copy(session.get("evidence") or [], _EVIDENCE_LIMIT),
+        "budget_used": int(session.get("budget_spent") or 0),
+        "budget_total": int(session.get("question_budget") or 0),
+        "diagnosis_threshold": float(session.get("diagnosis_threshold") or 0.0),
+    }
+    if selected_question_id:
+        output["selected_question_id"] = selected_question_id
+    if session.get("remediation"):
+        output["remediation"] = bounded_copy(session["remediation"], 5)
+    if session.get("retest"):
+        output["retest"] = bounded_copy(session["retest"], 5)
+    if session.get("review_task_id"):
+        output["review_task_id"] = session["review_task_id"]
+    return output
+
+
+def _retest_from_bank(session: dict[str, Any]) -> dict[str, Any] | None:
+    for question in session.get("bank") or []:
+        if str(question.get("purpose") or "").strip() == "retest":
+            return {
+                "question_id": str(question.get("id") or "").strip(),
+                "prompt": str(question.get("prompt") or "").strip()[:300],
+                "expected_answer": str(question.get("expected_answer") or "").strip()[:300],
+            }
+    return None
+
+
+# ── learning events ────────────────────────────────────────────────────────
+
+
+def append_event(
+    progress: LearningProgress,
+    *,
+    event_type: str,
+    topic_id: str,
+    source_event_id: str,
+    occurred_at: int,
+    aggregate_kind: str,
+    aggregate_id: str,
+    aggregate_revision: int,
+    data: dict[str, Any],
+) -> dict[str, Any]:
+    sequence = len(progress.event_feed) + 1
+    event_id = (
+        "evt-"
+        + sha256_hex(
+            stable_json(
+                {
+                    "path": progress.book_id,
+                    "type": event_type,
+                    "source": source_event_id,
+                    "aggregate": aggregate_id,
+                    "revision": aggregate_revision,
+                    "occurred_at": occurred_at,
+                    "sequence": sequence,
+                }
+            )
+        )[:40]
+    )
+    event = {
+        "schema_version": SCHEMA_VERSION,
+        "event_id": event_id,
+        "sequence": sequence,
+        "type": event_type,
+        "topic_id": str(topic_id or "")[:200],
+        "source_event_id": str(source_event_id or "")[:200],
+        "occurred_at": int(occurred_at),
+        "aggregate_kind": str(aggregate_kind or "")[:100],
+        "aggregate_id": str(aggregate_id or "")[:200],
+        "aggregate_revision": int(aggregate_revision),
+        "data": bounded_copy(data, 20),
+    }
+    progress.event_feed.append(event)
+    if len(progress.event_feed) > _FEED_LIMIT:
+        progress.event_feed = progress.event_feed[-_FEED_LIMIT:]
+    return event
+
+
+def learning_events_payload(
+    progress: LearningProgress,
+    *,
+    subscriber_id: str,
+    after_sequence: Any,
+    limit: Any,
+    event_types: Any,
+) -> tuple[dict[str, Any] | None, dict[str, Any]]:
+    if not isinstance(subscriber_id, str) or not subscriber_id.strip():
+        return None, {"error": "subscriber_id must be a non-empty string"}
+    if after_sequence is not None and (
+        not isinstance(after_sequence, int)
+        or isinstance(after_sequence, bool)
+        or after_sequence < 0
+    ):
+        return None, {"error": "after_sequence must be a non-negative integer"}
+    resolved_limit = _validated_limit(limit, default=50)
+    if resolved_limit is None:
+        return None, {"error": "limit must be an integer in 1..100"}
+    if event_types is not None:
+        if not isinstance(event_types, list) or not all(
+            isinstance(item, str) for item in event_types
+        ):
+            return None, {"error": "event_types must be an array of strings"}
+        event_types = [str(item)[:100] for item in event_types[:50]]
+    checkpoint = int(progress.event_checkpoints.get(subscriber_id, 0))
+    start = checkpoint if after_sequence is None else int(after_sequence)
+    events = [
+        event
+        for event in progress.event_feed
+        if int(event["sequence"]) > start
+        and (event_types is None or event.get("type") in event_types)
+    ][:resolved_limit]
+    high_water = int(progress.event_feed[-1]["sequence"]) if progress.event_feed else 0
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "status": "ok",
+        "subscriber_id": subscriber_id,
+        "checkpoint": checkpoint,
+        "high_water_sequence": high_water,
+        "events": bounded_copy(events, 100),
+    }, {}
+
+
+def learning_checkpoint(
+    progress: LearningProgress,
+    *,
+    subscriber_id: str,
+    through_sequence: Any,
+    expected_checkpoint: Any,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any], dict[str, Any]]:
+    """Returns (outcome, payload, mutation-response-or-{})."""
+    if not isinstance(subscriber_id, str) or not subscriber_id.strip():
+        return "error", {"error": "subscriber_id must be a non-empty string"}, {}
+    if not isinstance(through_sequence, int) or isinstance(through_sequence, bool) or through_sequence < 0:
+        return "error", {"error": "through_sequence must be a non-negative integer"}, {}
+    if not isinstance(expected_checkpoint, int) or isinstance(expected_checkpoint, bool) or expected_checkpoint < 0:
+        return "error", {"error": "expected_checkpoint must be a non-negative integer"}, {}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}, {}
+    fingerprint = {
+        "op": "learning_checkpoint",
+        "subscriber_id": subscriber_id,
+        "through_sequence": through_sequence,
+        "expected_checkpoint": expected_checkpoint,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "learning_checkpoint", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    current = int(progress.event_checkpoints.get(subscriber_id, 0))
+    high_water = int(progress.event_feed[-1]["sequence"]) if progress.event_feed else 0
+    if through_sequence < current or through_sequence > high_water:
+        return "error", {"error": "sequence_out_of_range"}
+    if expected_checkpoint != current:
+        return "error", {"error": "checkpoint_conflict"}
+    progress.event_checkpoints[subscriber_id] = through_sequence
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "checkpointed",
+        "subscriber_id": subscriber_id,
+        "checkpoint": through_sequence,
+        "high_water_sequence": high_water,
+        "replayed": False,
+    }
+    record_op(progress, event_id, "learning_checkpoint", fingerprint, response)
+    return "committed", response
+
+
+# ── review tasks ───────────────────────────────────────────────────────────
+
+
+def _opaque_task_id(path_id: str, concept_id: str, source_event_id: str) -> str:
+    return "task-" + sha256_hex(f"{path_id}|{concept_id}|{source_event_id}")[:32]
+
+
+def _task_payload(task: dict[str, Any], *, as_of: int) -> dict[str, Any]:
+    state = task.get("state") or "scheduled"
+    if state in ("scheduled", "due"):
+        state = "due" if int(task.get("due_at") or 0) <= int(as_of) else "scheduled"
+    return {
+        "task_id": task.get("task_id"),
+        "topic_id": task.get("topic_id"),
+        "concept_id": task.get("concept_id"),
+        "source_event_id": task.get("source_event_id"),
+        "state": state,
+        "due_at": int(task.get("due_at") or 0),
+        "priority": int(task.get("priority") or 0),
+        "interval_index": int(task.get("interval_index") or 0),
+        "revision": int(task.get("revision") or 1),
+        "remediation": bounded_copy(task.get("remediation") or {}, 5),
+        "retest": bounded_copy(task.get("retest") or {}, 5),
+    }
+
+
+def _active_task(progress: LearningProgress, task_id: str) -> dict[str, Any] | None:
+    for task in progress.review_tasks:
+        if task.get("task_id") == task_id:
+            return task
+    return None
+
+
+def _cancel_task(
+    progress: LearningProgress,
+    task: dict[str, Any],
+    *,
+    path_id: str,
+    reason: str,
+    occurred_at: int,
+    source_event_id: str,
+) -> None:
+    if task.get("state") in ("completed", "cancelled"):
+        return
+    task["state"] = "cancelled"
+    task["cancelled_at"] = int(occurred_at)
+    task["cancel_reason"] = str(reason or "")[:200]
+    task["revision"] = int(task.get("revision") or 1) + 1
+    append_event(
+        progress,
+        event_type="review_cancelled",
+        topic_id=str(task.get("topic_id") or ""),
+        source_event_id=source_event_id,
+        occurred_at=occurred_at,
+        aggregate_kind="review_task",
+        aggregate_id=str(task.get("task_id") or ""),
+        aggregate_revision=int(task.get("revision") or 1),
+        data={
+            "task_id": task.get("task_id"),
+            "reason": str(reason or "")[:200],
+            "cancelled_at": int(occurred_at),
+        },
+    )
+
+
+def create_review_task(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    session: dict[str, Any],
+    source_event_id: str,
+    occurred_at: int,
+) -> dict[str, Any] | None:
+    review_policy = session.get("review_policy")
+    if not review_policy:
+        return None
+    concept_id = str(review_policy.get("concept_id") or session.get("topic_id") or "").strip()
+    task_id = _opaque_task_id(path_id, concept_id, source_event_id)
+    intervals = [int(item) for item in review_policy.get("intervals_seconds") or [86400]]
+    retest = _retest_from_bank(session) or {"question_id": ""}
+    remediation = session.get("remediation") or {}
+    task = {
+        "task_id": task_id,
+        "topic_id": session.get("topic_id") or "",
+        "concept_id": concept_id,
+        "source_event_id": source_event_id,
+        "state": "scheduled",
+        "due_at": int(occurred_at) + intervals[0],
+        "priority": int(review_policy.get("priority") or 0),
+        "interval_index": 0,
+        "revision": 1,
+        "remediation": bounded_copy(remediation, 5),
+        "retest": bounded_copy(retest, 5),
+        "policy_version": int(_active_policy(progress).get("version") or 1),
+        "created_at": int(occurred_at),
+    }
+    progress.review_tasks.append(task)
+    if len(progress.review_tasks) > _TASK_LIMIT:
+        progress.review_tasks = progress.review_tasks[-_TASK_LIMIT:]
+    append_event(
+        progress,
+        event_type="remediation_scheduled",
+        topic_id=task["topic_id"],
+        source_event_id=source_event_id,
+        occurred_at=occurred_at,
+        aggregate_kind="review_task",
+        aggregate_id=task_id,
+        aggregate_revision=1,
+        data=_task_payload(task, as_of=occurred_at),
+    )
+    return task
+
+
+def review_plan_payload(
+    progress: LearningProgress,
+    *,
+    as_of: int | None,
+    limit: Any,
+    include_terminal: bool,
+) -> tuple[dict[str, Any] | None, dict[str, Any]]:
+    resolved_limit = _validated_limit(limit, default=20)
+    if resolved_limit is None:
+        return None, {"error": "limit must be an integer in 1..100"}
+    as_of = as_of_time(as_of)
+    tasks = []
+    for task in progress.review_tasks:
+        if not include_terminal and task.get("state") in ("completed", "cancelled"):
+            continue
+        tasks.append(_task_payload(task, as_of=as_of))
+    tasks.sort(
+        key=lambda t: (
+            int(t.get("due_at") or 0),
+            -int(t.get("priority") or 0),
+            str(t.get("task_id") or ""),
+        )
+    )
+    non_terminal = [t for t in tasks if t.get("state") not in ("completed", "cancelled")]
+    due_count = sum(1 for t in non_terminal if int(t.get("due_at") or 0) <= as_of)
+    next_due_at = min((int(t.get("due_at") or 0) for t in non_terminal), default=None)
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "status": "ok",
+        "as_of": as_of,
+        "due_count": due_count,
+        "next_due_at": next_due_at,
+        "total_count": len(non_terminal),
+        "tasks": tasks[:resolved_limit],
+    }, {}
+
+
+def review_reschedule(
+    progress: LearningProgress,
+    *,
+    task_id: str,
+    due_at: Any,
+    expected_revision: Any,
+    reason: str,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(task_id, str) or not task_id.strip():
+        return "error", {"error": "task_id must be a non-empty string"}
+    if not isinstance(due_at, int) or isinstance(due_at, bool):
+        return "error", {"error": "due_at must be an integer"}
+    if not isinstance(expected_revision, int) or isinstance(expected_revision, bool) or expected_revision <= 0:
+        return "error", {"error": "expected_revision must be a positive integer"}
+    if not isinstance(reason, str) or not reason.strip():
+        return "error", {"error": "reason must be a non-empty string"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    as_of = as_of_time(as_of)
+    fingerprint = {
+        "op": "review_reschedule",
+        "task_id": task_id,
+        "due_at": due_at,
+        "expected_revision": expected_revision,
+        "reason": reason,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "review_reschedule", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    task = _active_task(progress, task_id)
+    if task is None:
+        return "error", {"error": "task_not_found"}
+    if task.get("state") in ("completed", "cancelled"):
+        return "error", {"error": "task_terminal"}
+    if int(task.get("revision") or 1) != int(expected_revision):
+        return "error", {"error": "stale_revision"}
+    if due_at < as_of:
+        return "error", {"error": "invalid_due_at"}
+    task["due_at"] = int(due_at)
+    task["revision"] = int(task.get("revision") or 1) + 1
+    task["last_reschedule_reason"] = str(reason or "")[:200]
+    task["rescheduled_at"] = int(as_of)
+    append_event(
+        progress,
+        event_type="review_rescheduled",
+        topic_id=str(task.get("topic_id") or ""),
+        source_event_id=event_id,
+        occurred_at=as_of,
+        aggregate_kind="review_task",
+        aggregate_id=task_id,
+        aggregate_revision=int(task.get("revision") or 1),
+        data=_task_payload(task, as_of=as_of),
+    )
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "rescheduled",
+        "task_id": task_id,
+        "replayed": False,
+        "task": _task_payload(task, as_of=as_of),
+    }
+    record_op(progress, event_id, "review_reschedule", fingerprint, response)
+    return "committed", response
+
+
+def apply_retest_outcome(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    session: dict[str, Any],
+    question_id: str,
+    is_correct: bool,
+    observed_at: int,
+    source_event_id: str,
+) -> dict[str, Any] | None:
+    """Apply a retest answer to the open review task for this session."""
+    task_id = session.get("review_task_id")
+    if not task_id:
+        return None
+    task = _active_task(progress, task_id)
+    if task is None or task.get("state") in ("completed", "cancelled"):
+        return None
+    retest = task.get("retest") or {}
+    if str(retest.get("question_id") or "") != question_id:
+        return None
+    intervals = [int(item) for item in (session.get("review_policy") or {}).get("intervals_seconds") or [86400]]
+    if is_correct:
+        task["state"] = "completed"
+        task["completed_at"] = int(observed_at)
+        task["revision"] = int(task.get("revision") or 1) + 1
+        append_event(
+            progress,
+            event_type="review_completed",
+            topic_id=str(task.get("topic_id") or ""),
+            source_event_id=source_event_id,
+            occurred_at=observed_at,
+            aggregate_kind="review_task",
+            aggregate_id=task_id,
+            aggregate_revision=int(task.get("revision") or 1),
+            data={"task_id": task_id, "completed_at": int(observed_at)},
+        )
+        return {"task": _task_payload(task, as_of=observed_at), "outcome": "completed"}
+    next_index = min(int(task.get("interval_index") or 0) + 1, max(0, len(intervals) - 1))
+    task["interval_index"] = next_index
+    task["due_at"] = int(observed_at) + intervals[next_index]
+    task["revision"] = int(task.get("revision") or 1) + 1
+    task["state"] = "scheduled"
+    append_event(
+        progress,
+        event_type="review_retest_failed",
+        topic_id=str(task.get("topic_id") or ""),
+        source_event_id=source_event_id,
+        occurred_at=observed_at,
+        aggregate_kind="review_task",
+        aggregate_id=task_id,
+        aggregate_revision=int(task.get("revision") or 1),
+        data=_task_payload(task, as_of=observed_at),
+    )
+    return {"task": _task_payload(task, as_of=observed_at), "outcome": "retry"}
+
+
+# ── remediation delivery (Cycle 001 surface) ───────────────────────────────
+
+
+def _create_delivery(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    session: dict[str, Any],
+    task: dict[str, Any] | None,
+    source_event_id: str,
+    occurred_at: int,
+) -> dict[str, Any]:
+    remediation = session.get("remediation") or {}
+    retest = session.get("retest") or {}
+    delivery_id = (
+        "deliv-"
+        + sha256_hex(
+            stable_json(
+                {
+                    "path": path_id,
+                    "topic": session.get("topic_id"),
+                    "source": source_event_id,
+                    "occurred_at": occurred_at,
+                }
+            )
+        )[:24]
+    )
+    delivery = {
+        "delivery_id": delivery_id,
+        "topic_id": session.get("topic_id") or "",
+        "remediation": bounded_copy(remediation, 5),
+        "retest": bounded_copy(retest, 5),
+        "status": "open",
+        "created_at": int(occurred_at),
+        "order": len(progress.deliveries),
+        "consumer_id": None,
+        "generation": 0,
+        "attempt": 0,
+        "lease_expires_at": None,
+        "acked_at": None,
+        "outcome": None,
+        "source_event_id": source_event_id,
+        "review_task_id": (task or {}).get("task_id"),
+    }
+    progress.deliveries.append(delivery)
+    if len(progress.deliveries) > _DELIVERY_LIMIT:
+        progress.deliveries = progress.deliveries[-_DELIVERY_LIMIT:]
+    return delivery
+
+
+def _open_delivery(progress: LearningProgress, topic_id: str = "") -> dict[str, Any] | None:
+    topic_id = str(topic_id or "").strip()
+    for delivery in sorted(progress.deliveries, key=lambda d: int(d.get("order") or 0)):
+        if delivery.get("status") in ("open", "claimed"):
+            if not topic_id or str(delivery.get("topic_id") or "") == topic_id:
+                return delivery
+    return None
+
+
+def _delivery_payload(delivery: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "delivery_id": delivery.get("delivery_id"),
+        "topic_id": delivery.get("topic_id"),
+        "status": delivery.get("status"),
+        "consumer_id": delivery.get("consumer_id"),
+        "generation": int(delivery.get("generation") or 0),
+        "attempt": int(delivery.get("attempt") or 0),
+        "lease_expires_at": delivery.get("lease_expires_at"),
+        "created_at": int(delivery.get("created_at") or 0),
+        "remediation": bounded_copy(delivery.get("remediation") or {}, 5),
+        "retest": bounded_copy(delivery.get("retest") or {}, 5),
+        "review_task_id": delivery.get("review_task_id"),
+    }
+
+
+def remediation_status_payload(
+    progress: LearningProgress,
+    *,
+    topic_id: str,
+    as_of: int | None,
+) -> dict[str, Any]:
+    as_of = as_of_time(as_of)
+    session = progress.adaptive_state.get(topic_id)
+    deliveries = [
+        _delivery_payload(d) for d in progress.deliveries if d.get("topic_id") == topic_id
+    ]
+    tasks = [
+        _task_payload(t, as_of=as_of)
+        for t in progress.review_tasks
+        if t.get("topic_id") == topic_id
+    ]
+    if session is None:
+        return {
+            "schema_version": SCHEMA_VERSION,
+            "status": "empty",
+            "topic_id": topic_id,
+            "deliveries": deliveries,
+            "review_tasks": tasks,
+        }
+    top = max(session.get("hypotheses") or [], key=lambda h: float(h.get("confidence") or 0.0), default=None)
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "status": "active",
+        "topic_id": topic_id,
+        "action": "remediate" if session.get("remediated") else "diagnose",
+        "top_hypothesis": top.get("id") if top else None,
+        "top_confidence": round(float(top.get("confidence") or 0.0), 6) if top else 0.0,
+        "hypotheses": bounded_copy(session.get("hypotheses") or [], 20),
+        "evidence": bounded_copy(session.get("evidence") or [], _EVIDENCE_LIMIT),
+        "deliveries": deliveries,
+        "review_tasks": tasks,
+    }
+
+
+def remediation_reset(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    topic_id: str,
+    reason: str,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(topic_id, str) or not topic_id.strip():
+        return "error", {"error": "topic_id must be a non-empty string"}
+    if not isinstance(reason, str) or not reason.strip():
+        return "error", {"error": "reason must be a non-empty string"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    as_of = as_of_time(as_of)
+    fingerprint = {
+        "op": "remediation_reset",
+        "topic_id": topic_id,
+        "reason": reason,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "remediation_reset", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    session = progress.adaptive_state.get(topic_id)
+    cancelled_tasks = 0
+    for task in progress.review_tasks:
+        if task.get("topic_id") == topic_id and task.get("state") not in ("completed", "cancelled"):
+            _cancel_task(progress, task, path_id=path_id, reason=reason, occurred_at=as_of, source_event_id=event_id)
+            cancelled_tasks += 1
+    cancelled_deliveries = 0
+    for delivery in progress.deliveries:
+        if delivery.get("topic_id") == topic_id and delivery.get("status") in ("open", "claimed"):
+            delivery["status"] = "cancelled"
+            delivery["cancelled_at"] = int(as_of)
+            delivery["cancel_reason"] = str(reason or "")[:200]
+            cancelled_deliveries += 1
+    if session is not None:
+        session["reset_count"] = int(session.get("reset_count") or 0) + 1
+        progress.adaptive_state.pop(topic_id, None)
+    append_event(
+        progress,
+        event_type="adaptive_reset",
+        topic_id=topic_id,
+        source_event_id=event_id,
+        occurred_at=as_of,
+        aggregate_kind="adaptive_session",
+        aggregate_id=topic_id,
+        aggregate_revision=int(session.get("reset_count") or 1) if session else 1,
+        data={"topic_id": topic_id, "reason": str(reason or "")[:200], "reset_at": int(as_of)},
+    )
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "reset",
+        "topic_id": topic_id,
+        "replayed": False,
+        "review_tasks_cancelled": cancelled_tasks,
+        "deliveries_cancelled": cancelled_deliveries,
+    }
+    record_op(progress, event_id, "remediation_reset", fingerprint, response)
+    return "committed", response
+
+
+def remediation_claim(
+    progress: LearningProgress,
+    *,
+    topic_id: str,
+    consumer_id: str,
+    event_id: str,
+    lease_seconds: Any,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    topic_id = str(topic_id or "").strip()
+    if not isinstance(consumer_id, str) or not consumer_id.strip():
+        return "error", {"error": "consumer_id must be a non-empty string"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    if not isinstance(lease_seconds, int) or isinstance(lease_seconds, bool) or lease_seconds <= 0:
+        return "error", {"error": "lease_seconds must be a positive integer"}
+    as_of = as_of_time(as_of)
+    fingerprint = {
+        "op": "remediation_claim",
+        "topic_id": topic_id,
+        "consumer_id": consumer_id,
+        "event_id": event_id,
+        "lease_seconds": lease_seconds,
+    }
+    outcome, stored = _begin_op(progress, event_id, "remediation_claim", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    delivery = _open_delivery(progress, topic_id)
+    if delivery is None:
+        response = {
+            "schema_version": SCHEMA_VERSION,
+            "status": "empty",
+            "topic_id": topic_id,
+            "replayed": False,
+        }
+        record_op(progress, event_id, "remediation_claim", fingerprint, response)
+        return "committed", response
+    if delivery.get("status") == "claimed":
+        lease_expires = int(delivery.get("lease_expires_at") or 0)
+        if lease_expires > as_of and delivery.get("consumer_id") != consumer_id:
+            response = {
+                "schema_version": SCHEMA_VERSION,
+                "status": "busy",
+                "topic_id": topic_id,
+                "delivery": _delivery_payload(delivery),
+                "replayed": False,
+            }
+            record_op(progress, event_id, "remediation_claim", fingerprint, response)
+            return "committed", response
+    delivery["status"] = "claimed"
+    delivery["consumer_id"] = consumer_id
+    delivery["generation"] = int(delivery.get("generation") or 0) + 1
+    delivery["attempt"] = int(delivery.get("attempt") or 0) + 1
+    delivery["lease_expires_at"] = int(as_of) + int(lease_seconds)
+    delivery["claimed_at"] = int(as_of)
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "claimed",
+        "topic_id": topic_id,
+        "delivery": _delivery_payload(delivery),
+        "replayed": False,
+    }
+    record_op(progress, event_id, "remediation_claim", fingerprint, response)
+    return "committed", response
+
+
+def remediation_ack(
+    progress: LearningProgress,
+    *,
+    delivery_id: str,
+    consumer_id: str,
+    generation: Any,
+    event_id: str,
+    outcome: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(delivery_id, str) or not delivery_id.strip():
+        return "error", {"error": "delivery_id must be a non-empty string"}
+    if not isinstance(consumer_id, str) or not consumer_id.strip():
+        return "error", {"error": "consumer_id must be a non-empty string"}
+    if not isinstance(generation, int) or isinstance(generation, bool) or generation <= 0:
+        return "error", {"error": "generation must be a positive integer"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    as_of = as_of_time(as_of)
+    fingerprint = {
+        "op": "remediation_ack",
+        "delivery_id": delivery_id,
+        "consumer_id": consumer_id,
+        "generation": generation,
+        "event_id": event_id,
+        "outcome": outcome,
+    }
+    outcome, stored = _begin_op(progress, event_id, "remediation_ack", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    delivery = None
+    for item in progress.deliveries:
+        if item.get("delivery_id") == delivery_id:
+            delivery = item
+            break
+    if delivery is None:
+        return "error", {"error": "delivery_not_found"}
+    if delivery.get("status") in ("cancelled",):
+        return "error", {"error": "delivery_cancelled"}
+    if delivery.get("status") == "acked":
+        return "error", {"error": "delivery_conflict"}
+    if (
+        delivery.get("status") != "claimed"
+        or delivery.get("consumer_id") != consumer_id
+        or int(delivery.get("generation") or 0) != int(generation)
+        or int(delivery.get("lease_expires_at") or 0) <= as_of
+    ):
+        return "error", {"error": "stale_lease"}
+    delivery["status"] = "acked"
+    delivery["acked_at"] = int(as_of)
+    delivery["outcome"] = str(outcome or "")[:100]
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "acknowledged",
+        "delivery_id": delivery_id,
+        "consumer_id": consumer_id,
+        "generation": int(generation),
+        "outcome": str(outcome or "")[:100],
+        "replayed": False,
+    }
+    record_op(progress, event_id, "remediation_ack", fingerprint, response)
+    return "committed", response
+
+
+# ── policy registry (Cycle 003) ────────────────────────────────────────────
+
+
+def _default_policy_data(policy_id: str) -> dict[str, Any]:
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "concept_id": str(policy_id or "default")[:200],
+        "priority": 0,
+        "intervals_seconds": [86400],
+    }
+
+
+def _policy_digest(policy_id: str, version: int, data: Any) -> str:
+    return sha256_hex(stable_json({"policy_id": policy_id, "version": version, "data": data}))
+
+
+def _active_policy(progress: LearningProgress, policy_id: str = "default") -> dict[str, Any]:
+    record = progress.policies.get(policy_id)
+    if record is not None:
+        return dict(record)
+    return {
+        "policy_id": policy_id,
+        "version": 1,
+        "data": _default_policy_data(policy_id),
+        "digest": _policy_digest(policy_id, 1, _default_policy_data(policy_id)),
+        "effective_at": None,
+    }
+
+
+def _migration_required(progress: LearningProgress, active_version: int) -> bool:
+    return any(
+        int(task.get("policy_version") or 1) < int(active_version)
+        for task in progress.review_tasks
+    )
+
+
+def policy_status_payload(
+    progress: LearningProgress,
+    *,
+    policy_id: str,
+    as_of: int | None,
+) -> tuple[dict[str, Any] | None, dict[str, Any]]:
+    if not isinstance(policy_id, str) or not policy_id.strip():
+        return None, {"error": "policy_id must be a non-empty string"}
+    if policy_id not in progress.policies:
+        progress.policies[policy_id] = _active_policy(progress, policy_id)
+    record = progress.policies[policy_id]
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "status": "ok",
+        "policy_id": policy_id,
+        "version": int(record.get("version") or 1),
+        "policy": bounded_copy(record.get("data") or {}, 10),
+        "digest": str(record.get("digest") or ""),
+        "effective_at": record.get("effective_at"),
+        "migration_required": _migration_required(progress, int(record.get("version") or 1)),
+        "as_of": as_of_time(as_of),
+    }, {}
+
+
+def policy_publish(
+    progress: LearningProgress,
+    *,
+    actor_id: str,
+    policy_id: str,
+    policy: Any,
+    version: Any,
+    expected_version: Any,
+    effective_at: Any,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(actor_id, str) or not actor_id.strip():
+        return "error", {"error": "unauthorized"}
+    if actor_id.strip().casefold() in {_UNTRUSTED_ACTOR}:
+        return "error", {"error": "unauthorized"}
+    if not isinstance(policy_id, str) or not policy_id.strip():
+        return "error", {"error": "policy_id must be a non-empty string"}
+    if not isinstance(version, int) or isinstance(version, bool) or version <= 0:
+        return "error", {"error": "policy_version_invalid"}
+    if not isinstance(expected_version, int) or isinstance(expected_version, bool) or expected_version <= 0:
+        return "error", {"error": "expected_version_invalid"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    malformed = validate_policy_data(policy)
+    if malformed:
+        return "error", {"error": "policy_malformed", "message": malformed}
+    fingerprint = {
+        "op": "policy_publish",
+        "actor_id": actor_id,
+        "policy_id": policy_id,
+        "policy": bounded_copy(policy, 10),
+        "version": version,
+        "expected_version": expected_version,
+        "effective_at": effective_at,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "policy_publish", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    current = _active_policy(progress, policy_id)
+    current_version = int(current.get("version") or 1)
+    if int(expected_version) != current_version:
+        return "error", {"error": "stale_version"}
+    if int(version) <= current_version:
+        return "error", {"error": "policy_conflict"}
+    current_effective = current.get("effective_at")
+    if effective_at is not None:
+        if not isinstance(effective_at, int) or isinstance(effective_at, bool):
+            return "error", {"error": "invalid_effective_at"}
+        if current_effective is not None and int(effective_at) < int(current_effective):
+            return "error", {"error": "regressive_effective_time"}
+        if int(effective_at) > as_of_time(as_of):
+            return "error", {"error": "future_effective_time"}
+    record = {
+        "policy_id": policy_id,
+        "version": int(version),
+        "data": bounded_copy(policy, 10),
+        "digest": _policy_digest(policy_id, int(version), policy),
+        "effective_at": effective_at,
+        "actor_id": str(actor_id or "")[:200],
+        "event_id": event_id,
+        "published_at": as_of_time(as_of),
+    }
+    progress.policies[policy_id] = record
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "published",
+        "policy_id": policy_id,
+        "version": int(version),
+        "digest": record["digest"],
+        "policy": bounded_copy(policy, 10),
+        "effective_at": effective_at,
+        "replayed": False,
+    }
+    record_op(progress, event_id, "policy_publish", fingerprint, response)
+    return "committed", response
+
+
+# ── session handoffs (Cycle 003) ───────────────────────────────────────────
+
+
+def _handoff_payload(handoff: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "handoff_id": handoff.get("handoff_id"),
+        "status": handoff.get("status"),
+        "revision": int(handoff.get("revision") or 1),
+        "policy_version": handoff.get("policy_version"),
+        "actor_id": handoff.get("actor_id"),
+        "pending_question": bounded_copy(handoff.get("pending_question") or {}, 10),
+        "expires_at": handoff.get("expires_at"),
+        "created_at": handoff.get("created_at"),
+    }
+
+
+def _find_handoff(progress: LearningProgress, handoff_id: str) -> dict[str, Any] | None:
+    for handoff in reversed(progress.handoffs):
+        if handoff.get("handoff_id") == handoff_id:
+            return handoff
+    return None
+
+
+def handoff_create(
+    progress: LearningProgress,
+    *,
+    actor_id: str,
+    handoff_id: str,
+    expected_revision: Any,
+    pending_question: Any,
+    policy_version: Any,
+    expires_at: Any,
+    event_id: str,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(actor_id, str) or not actor_id.strip():
+        return "error", {"error": "unauthorized"}
+    if not isinstance(handoff_id, str) or not handoff_id.strip():
+        return "error", {"error": "handoff_id must be a non-empty string"}
+    if not isinstance(expected_revision, int) or isinstance(expected_revision, bool) or expected_revision < 0:
+        return "error", {"error": "expected_revision must be a non-negative integer"}
+    if not isinstance(pending_question, dict):
+        return "error", {"error": "pending_question must be an object"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    if expires_at is not None and (
+        not isinstance(expires_at, int) or isinstance(expires_at, bool)
+    ):
+        return "error", {"error": "expires_at must be an integer"}
+    fingerprint = {
+        "op": "handoff_create",
+        "actor_id": actor_id,
+        "handoff_id": handoff_id,
+        "expected_revision": expected_revision,
+        "pending_question": bounded_copy(pending_question, 10),
+        "policy_version": policy_version,
+        "expires_at": expires_at,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "handoff_create", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    existing = _find_handoff(progress, handoff_id)
+    if existing is not None:
+        return "error", {"error": "handoff_conflict"}
+    if int(expected_revision) != 0:
+        return "error", {"error": "stale_revision"}
+    policy_version = int(policy_version or 1) if policy_version is not None else 1
+    handoff = {
+        "handoff_id": handoff_id,
+        "status": "open",
+        "revision": 1,
+        "policy_version": int(policy_version),
+        "actor_id": str(actor_id or "")[:200],
+        "pending_question": bounded_copy(pending_question, 10),
+        "expires_at": int(expires_at) if expires_at is not None else None,
+        "created_at": int(time.time()),
+        "event_id": event_id,
+    }
+    progress.handoffs.append(handoff)
+    if len(progress.handoffs) > _HANDOFF_LIMIT:
+        progress.handoffs = progress.handoffs[-_HANDOFF_LIMIT:]
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "created",
+        "handoff_id": handoff_id,
+        "handoff": _handoff_payload(handoff),
+        "revision": int(handoff["revision"]),
+        "replayed": False,
+    }
+    record_op(progress, event_id, "handoff_create", fingerprint, response)
+    return "committed", response
+
+
+def handoff_list_payload(
+    progress: LearningProgress,
+    *,
+    include_terminal: bool,
+    as_of: int | None,
+) -> dict[str, Any]:
+    as_of = as_of_time(as_of)
+    handoffs = []
+    for handoff in reversed(progress.handoffs):
+        if not include_terminal and handoff.get("status") in ("abandoned", "expired"):
+            continue
+        payload = _handoff_payload(handoff)
+        if handoff.get("status") == "open" and handoff.get("expires_at") is not None:
+            if int(handoff["expires_at"]) <= as_of:
+                payload["status"] = "expired"
+        handoffs.append(payload)
+        if len(handoffs) >= _HANDOFF_LIMIT:
+            break
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "status": "ok",
+        "handoffs": handoffs,
+        "as_of": as_of,
+    }
+
+
+def _handoff_mutate_guard(
+    progress: LearningProgress,
+    *,
+    actor_id: str,
+    handoff_id: str,
+    expected_revision: Any,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any], dict[str, Any]]:
+    if not isinstance(actor_id, str) or not actor_id.strip():
+        return "error", {"error": "unauthorized"}, None
+    if not isinstance(handoff_id, str) or not handoff_id.strip():
+        return "error", {"error": "handoff_id must be a non-empty string"}, None
+    if not isinstance(expected_revision, int) or isinstance(expected_revision, bool) or expected_revision <= 0:
+        return "error", {"error": "expected_revision must be a positive integer"}, None
+    handoff = _find_handoff(progress, handoff_id)
+    if handoff is None:
+        return "error", {"error": "handoff_not_found"}, None
+    if handoff.get("status") in ("abandoned", "expired"):
+        return "error", {"error": "handoff_terminal"}, None
+    if int(handoff.get("revision") or 1) != int(expected_revision):
+        return "error", {"error": "stale_revision"}, None
+    if handoff.get("actor_id") != actor_id:
+        return "error", {"error": "unauthorized"}, None
+    if as_of is not None and handoff.get("expires_at") is not None and int(handoff["expires_at"]) <= as_of_time(as_of):
+        return "error", {"error": "handoff_expired"}, None
+    return "ok", {}, handoff
+
+
+def handoff_resume(
+    progress: LearningProgress,
+    *,
+    actor_id: str,
+    handoff_id: str,
+    expected_revision: Any,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    fingerprint = {
+        "op": "handoff_resume",
+        "actor_id": actor_id,
+        "handoff_id": handoff_id,
+        "expected_revision": expected_revision,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "handoff_resume", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    guard, error, handoff = _handoff_mutate_guard(
+        progress, actor_id=actor_id, handoff_id=handoff_id, expected_revision=expected_revision, as_of=as_of
+    )
+    if guard != "ok":
+        return "error", error
+    handoff["revision"] = int(handoff.get("revision") or 1) + 1
+    handoff["status"] = "open"
+    handoff["resumed_at"] = as_of_time(as_of)
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "resumed",
+        "handoff_id": handoff_id,
+        "handoff": _handoff_payload(handoff),
+        "revision": int(handoff["revision"]),
+        "replayed": False,
+    }
+    record_op(progress, event_id, "handoff_resume", fingerprint, response)
+    return "committed", response
+
+
+def handoff_abandon(
+    progress: LearningProgress,
+    *,
+    actor_id: str,
+    handoff_id: str,
+    expected_revision: Any,
+    event_id: str,
+    reason: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    fingerprint = {
+        "op": "handoff_abandon",
+        "actor_id": actor_id,
+        "handoff_id": handoff_id,
+        "expected_revision": expected_revision,
+        "event_id": event_id,
+        "reason": reason,
+    }
+    outcome, stored = _begin_op(progress, event_id, "handoff_abandon", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    guard, error, handoff = _handoff_mutate_guard(
+        progress, actor_id=actor_id, handoff_id=handoff_id, expected_revision=expected_revision, as_of=as_of
+    )
+    if guard != "ok":
+        return "error", error
+    handoff["revision"] = int(handoff.get("revision") or 1) + 1
+    handoff["status"] = "abandoned"
+    handoff["abandoned_at"] = as_of_time(as_of)
+    handoff["abandon_reason"] = str(reason or "")[:200]
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "abandoned",
+        "handoff_id": handoff_id,
+        "handoff": _handoff_payload(handoff),
+        "revision": int(handoff["revision"]),
+        "replayed": False,
+    }
+    record_op(progress, event_id, "handoff_abandon", fingerprint, response)
+    return "committed", response
