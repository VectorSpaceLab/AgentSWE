+def _begin_adaptive_op(
+    progress: Any, event_id: str, kind: str, fingerprint: dict[str, Any]
+) -> tuple[str, dict[str, Any] | None]:
+    """Idempotency peek used by the adaptive quiz registration path."""
+    from deeptutor.learning.adaptive import peek_record, record_op
+
+    stored = peek_record(progress, event_id, kind)
+    if stored is not None:
+        if record_op(progress, event_id, kind, fingerprint, {})[0] == "conflict":
+            return "conflict", None
+        return "replayed", stored
+    return "fresh", None
+
+
+def _mutating_result(
+    outcome: str,
+    result: dict[str, Any],
+    *,
+    service: Any,
+    progress: Any,
+    meta_key: str,
+) -> ToolResult:
+    """Persist a committed mutation and wrap the result as a ToolResult."""
+    if outcome == "committed":
+        service.save(progress)
+    return _json_result(
+        dict(result),
+        meta_key=meta_key,
+        success=outcome != "error",
+    )
+
