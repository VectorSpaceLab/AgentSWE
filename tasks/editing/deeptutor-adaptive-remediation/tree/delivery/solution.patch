+# ── learner portfolio snapshot (Cycle 004) ─────────────────────────────────
+
+
+def _snapshot_mastery(progress: LearningProgress, limit: int) -> list[dict[str, Any]]:
+    from deeptutor.learning.policy import display_mastery, find_knowledge_point, is_mastered
+
+    items: list[dict[str, Any]] = []
+    for kp_id, level in progress.mastery_levels.items():
+        kp, _, _ = find_knowledge_point(progress, kp_id)
+        items.append(
+            {
+                "knowledge_point_id": kp_id,
+                "name": kp.name if kp else "",
+                "type": progress.knowledge_types.get(kp_id).value
+                if progress.knowledge_types.get(kp_id)
+                else "",
+                "mastery": round(float(display_mastery(progress, kp) if kp else level), 6),
+                "mastered": bool(kp and is_mastered(progress, kp)),
+                "status": "mastered" if kp and is_mastered(progress, kp) else "learning",
+            }
+        )
+    return items[:limit]
+
+
+def _snapshot_reviews(progress: LearningProgress, as_of: int, limit: int) -> list[dict[str, Any]]:
+    tasks = [_task_payload(t, as_of=as_of) for t in progress.review_tasks]
+    return tasks[:limit]
+
+
+def _snapshot_handoffs(progress: LearningProgress, as_of: int, limit: int) -> list[dict[str, Any]]:
+    handoffs = []
+    for handoff in reversed(progress.handoffs):
+        if handoff.get("status") in ("abandoned", "expired"):
+            continue
+        payload = _handoff_payload(handoff)
+        if payload.get("status") == "open" and payload.get("expires_at") is not None:
+            if int(payload["expires_at"]) <= as_of:
+                payload["status"] = "expired"
+        handoffs.append(payload)
+        if len(handoffs) >= limit:
+            break
+    return handoffs
+
+
+def _snapshot_policy(progress: LearningProgress) -> dict[str, Any]:
+    best: dict[str, Any] | None = None
+    for record in progress.policies.values():
+        if best is None or int(record.get("version") or 1) > int(best.get("version") or 1):
+            best = record
+    if best is None:
+        best = _active_policy(progress, "default")
+    return {
+        "policy_id": best.get("policy_id") or "default",
+        "version": int(best.get("version") or 1),
+        "digest": str(best.get("digest") or ""),
+        "data": bounded_copy(best.get("data") or {}, 10),
+    }
+
+
+def _snapshot_lineage(progress: LearningProgress) -> dict[str, Any]:
+    return {
+        "review_task_ids": [str(t.get("task_id") or "") for t in progress.review_tasks if t.get("task_id")],
+        "event_sequences": [int(e.get("sequence") or 0) for e in progress.event_feed if e.get("sequence")],
+    }
+
+
+def build_snapshot_body(
+    progress: LearningProgress,
+    *,
+    as_of: int,
+    limit: int,
+    include_terminal: bool,
+) -> dict[str, Any]:
+    mastery = _snapshot_mastery(progress, min(limit, _SNAPSHOT_COLLECTION_LIMIT))
+    reviews = _snapshot_reviews(progress, as_of, min(limit, _SNAPSHOT_COLLECTION_LIMIT))
+    handoffs = _snapshot_handoffs(progress, as_of, min(limit, _SNAPSHOT_COLLECTION_LIMIT))
+    policy = _snapshot_policy(progress)
+    lineage = _snapshot_lineage(progress)
+    high_water = int(progress.event_feed[-1]["sequence"]) if progress.event_feed else 0
+    event_feed = progress.event_feed[-_SNAPSHOT_FEED_PROJECTION:]
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "as_of": int(as_of),
+        "snapshot_revision": 0,
+        "high_water_sequence": high_water,
+        "mastery": mastery,
+        "reviews": reviews,
+        "handoffs": handoffs,
+        "policy": policy,
+        "lineage": lineage,
+        "event_feed": bounded_copy(event_feed, _SNAPSHOT_FEED_PROJECTION),
+    }
+
+
+def canonical_snapshot_digest(body: dict[str, Any]) -> str:
+    """Deterministic digest over the bounded canonical snapshot projection."""
+    canonical = {
+        "schema_version": body.get("schema_version"),
+        "snapshot_revision": body.get("snapshot_revision"),
+        "high_water_sequence": body.get("high_water_sequence"),
+        "mastery": body.get("mastery", []),
+        "reviews": body.get("reviews", []),
+        "handoffs": body.get("handoffs", []),
+        "policy": body.get("policy", {}),
+        "lineage": body.get("lineage", {}),
+    }
+    return sha256_hex(stable_json(canonical))
+
+
+def _snapshot_seal_digest(body: dict[str, Any]) -> str:
+    seal = {
+        "canonical": canonical_snapshot_digest(body),
+        "event_feed": body.get("event_feed", []),
+        "covered": ["mastery", "reviews", "handoffs", "policy", "lineage", "event_feed"],
+    }
+    return sha256_hex(stable_json(seal))
+
+
+def _embedded_attestation(body: dict[str, Any], snapshot_digest: str) -> dict[str, Any]:
+    revision = int(body.get("snapshot_revision") or 0)
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "state": "verified",
+        "source": "mastery_learner_snapshot",
+        "snapshot_digest": snapshot_digest,
+        "canonical_digest": canonical_snapshot_digest(body),
+        "snapshot_revision": revision,
+        "high_water_sequence": int(body.get("high_water_sequence") or 0),
+        "policy_version": int((body.get("policy") or {}).get("version") or 1),
+        "covered": ["mastery", "reviews", "handoffs", "policy", "lineage", "event_feed"],
+        "proof": snapshot_digest,
+    }
+
+
+def invalidate_snapshot(progress: LearningProgress) -> None:
+    if progress.portfolio.get("body"):
+        progress.portfolio["invalidated"] = True
+
+
+def snapshot_payload(
+    progress: LearningProgress,
+    *,
+    as_of: int | None,
+    limit: Any,
+    include_terminal: bool,
+) -> tuple[dict[str, Any] | None, dict[str, Any]]:
+    resolved_limit = _validated_limit(limit, default=50)
+    if resolved_limit is None:
+        return None, {"error": "limit must be an integer in 1..100"}
+    as_of = as_of_time(as_of)
+    if progress.portfolio.get("body") and not progress.portfolio.get("invalidated"):
+        body = bounded_copy(progress.portfolio["body"], _SNAPSHOT_FEED_PROJECTION)
+        body["as_of"] = as_of
+        revision = int(progress.portfolio.get("revision") or 0)
+        snapshot_digest = str(progress.portfolio.get("digest") or "")
+        attestation = bounded_copy(progress.portfolio.get("attestation") or {}, 20)
+    else:
+        body = build_snapshot_body(
+            progress, as_of=as_of, limit=resolved_limit, include_terminal=include_terminal
+        )
+        prior_revision = progress.portfolio.get("revision")
+        revision = (int(prior_revision) if prior_revision is not None else -1) + 1
+        body["snapshot_revision"] = revision
+        snapshot_digest = _snapshot_seal_digest(body)
+        attestation = _embedded_attestation(body, snapshot_digest)
+        progress.portfolio = {
+            "revision": revision,
+            "digest": snapshot_digest,
+            "attestation": attestation,
+            "body": bounded_copy(body, _SNAPSHOT_FEED_PROJECTION),
+            "invalidated": False,
+        }
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "status": "ok",
+        "as_of": as_of,
+        "snapshot_revision": revision,
+        "high_water_sequence": int(body.get("high_water_sequence") or 0),
+        "digest": snapshot_digest,
+        "mastery": bounded_copy(body.get("mastery", []), _SNAPSHOT_COLLECTION_LIMIT),
+        "reviews": bounded_copy(body.get("reviews", []), _SNAPSHOT_COLLECTION_LIMIT),
+        "handoffs": bounded_copy(body.get("handoffs", []), _SNAPSHOT_COLLECTION_LIMIT),
+        "policy": bounded_copy(body.get("policy", {}), 10),
+        "lineage": bounded_copy(body.get("lineage", {}), 10),
+        "attestation": bounded_copy(attestation, 20),
+    }, {}
+
+
+def _snapshot_checkpoint_state(progress: LearningProgress) -> dict[str, Any]:
+    if progress.witness_entries:
+        head = progress.witness_entries[-1]
+        return {
+            "witness_root_digest": str(head.get("root_digest") or ""),
+            "witness_sequence": int(head.get("sequence") or 0),
+        }
+    return {}
+
+
+def snapshot_checkpoint(
+    progress: LearningProgress,
+    *,
+    subscriber_id: str,
+    through_revision: Any,
+    expected_checkpoint: Any,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(subscriber_id, str) or not subscriber_id.strip():
+        return "error", {"error": "subscriber_id must be a non-empty string"}
+    if not isinstance(through_revision, int) or isinstance(through_revision, bool) or through_revision < 0:
+        return "error", {"error": "through_revision must be a non-negative integer"}
+    if not isinstance(expected_checkpoint, int) or isinstance(expected_checkpoint, bool) or expected_checkpoint < 0:
+        return "error", {"error": "expected_checkpoint must be a non-negative integer"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    fingerprint = {
+        "op": "snapshot_checkpoint",
+        "subscriber_id": subscriber_id,
+        "through_revision": through_revision,
+        "expected_checkpoint": expected_checkpoint,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "snapshot_checkpoint", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    current = int((progress.snapshot_checkpoints.get(subscriber_id) or {}).get("checkpoint") or 0)
+    current_revision = int(progress.portfolio.get("revision") or 0) if progress.portfolio.get("body") else 0
+    if int(expected_checkpoint) != current:
+        return "error", {"error": "snapshot_checkpoint_conflict"}
+    if int(through_revision) > current_revision:
+        return "error", {"error": "snapshot_revision_out_of_range"}
+    if int(through_revision) < current:
+        return "error", {"error": "snapshot_revision_out_of_range"}
+    attestation = progress.portfolio.get("attestation") or {}
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "checkpointed",
+        "subscriber_id": subscriber_id,
+        "through_revision": int(through_revision),
+        "checkpoint": int(through_revision),
+        "snapshot_digest": str(progress.portfolio.get("digest") or ""),
+        "attestation_digest": str(attestation.get("canonical_digest") or ""),
+        "replayed": False,
+    }
+    response.update(_snapshot_checkpoint_state(progress))
+    progress.snapshot_checkpoints[subscriber_id] = {
+        "checkpoint": int(through_revision),
+        "event_id": event_id,
+    }
+    record_op(progress, event_id, "snapshot_checkpoint", fingerprint, response)
+    return "committed", response
+
+
+# ── snapshot provenance attestation / restore (Cycle 005) ──────────────────
+
+
+def _find_stored_attestation(
+    progress: LearningProgress,
+    *,
+    snapshot_revision: int,
+    snapshot_digest: str,
+    attestation_id: str | None = None,
+) -> dict[str, Any] | None:
+    attestations = progress.portfolio.get("attestations") or {}
+    if isinstance(attestations, dict):
+        for record in attestations.values():
+            if (
+                isinstance(record, dict)
+                and record.get("snapshot_revision") is not None
+                and int(record["snapshot_revision"]) == int(snapshot_revision)
+                and str(record.get("snapshot_digest") or "") == str(snapshot_digest)
+                and (
+                    not attestation_id
+                    or str(record.get("attestation_id") or "") == str(attestation_id)
+                )
+            ):
+                return record
+    embedded = progress.portfolio.get("attestation") or {}
+    if (
+        isinstance(embedded, dict)
+        and embedded.get("snapshot_revision") is not None
+        and int(embedded["snapshot_revision"]) == int(snapshot_revision)
+        and str(embedded.get("snapshot_digest") or "") == str(snapshot_digest)
+        and (
+            not attestation_id
+            or str(embedded.get("attestation_id") or "") == str(attestation_id)
+        )
+    ):
+        return embedded
+    return None
+
+
+def snapshot_attest(
+    progress: LearningProgress,
+    *,
+    snapshot_revision: Any,
+    snapshot_digest: Any,
+    high_water_sequence: Any,
+    policy_version: Any,
+    challenge: str,
+    attestation_id: str | None,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(snapshot_revision, int) or isinstance(snapshot_revision, bool) or snapshot_revision < 0:
+        return "error", {"error": "snapshot_revision must be a non-negative integer"}
+    if not isinstance(snapshot_digest, str) or not snapshot_digest.strip():
+        return "error", {"error": "snapshot_digest must be a non-empty string"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    attestation_id = str(attestation_id or "").strip() or None
+    fingerprint = {
+        "op": "snapshot_attest",
+        "snapshot_revision": snapshot_revision,
+        "snapshot_digest": snapshot_digest,
+        "high_water_sequence": high_water_sequence,
+        "policy_version": policy_version,
+        "challenge": challenge,
+        "attestation_id": attestation_id,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "snapshot_attest", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    body = progress.portfolio.get("body")
+    if not body:
+        return "error", {"error": "snapshot_not_found"}
+    current_revision = int(progress.portfolio.get("revision") or 0)
+    current_digest = str(progress.portfolio.get("digest") or "")
+    if int(snapshot_revision) != current_revision or str(snapshot_digest) != current_digest:
+        return "error", {"error": "snapshot_fork"}
+    canonical = canonical_snapshot_digest(body)
+    proof = sha256_hex(
+        stable_json(
+            {
+                "canonical": canonical,
+                "event_feed": body.get("event_feed", []),
+                "challenge": str(challenge or "")[:200],
+                "attestation_id": attestation_id or "",
+                "event_id": event_id,
+                "covered": ["mastery", "reviews", "handoffs", "policy", "lineage", "event_feed"],
+            }
+        )
+    )
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "state": "verified",
+        "status": "verified",
+        "attestation_id": attestation_id or ("att-" + sha256_hex(event_id)[:24]),
+        "snapshot_revision": current_revision,
+        "snapshot_digest": current_digest,
+        "high_water_sequence": int(body.get("high_water_sequence") or 0),
+        "policy_version": int((body.get("policy") or {}).get("version") or 1),
+        "covered": ["mastery", "reviews", "handoffs", "policy", "lineage", "event_feed"],
+        "canonical_digest": canonical,
+        "proof": proof,
+        "replayed": False,
+    }
+    progress.portfolio.setdefault("attestations", {})[response["attestation_id"]] = {
+        "snapshot_revision": current_revision,
+        "snapshot_digest": current_digest,
+        "canonical_digest": canonical,
+        "proof": proof,
+        "challenge": str(challenge or "")[:200],
+        "attestation_id": response["attestation_id"],
+    }
+    _bounded_dict(progress.portfolio["attestations"], 200)
+    record_op(progress, event_id, "snapshot_attest", fingerprint, response)
+    return "committed", response
+
+
+def snapshot_restore(
+    progress: LearningProgress,
+    *,
+    snapshot_revision: Any,
+    snapshot_digest: Any,
+    high_water_sequence: Any,
+    policy_version: Any,
+    challenge: str,
+    attestation_id: str | None,
+    attestation_ref: str | None,
+    expected_revision: Any,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(snapshot_revision, int) or isinstance(snapshot_revision, bool) or snapshot_revision < 0:
+        return "error", {"error": "snapshot_revision must be a non-negative integer"}
+    if not isinstance(snapshot_digest, str) or not snapshot_digest.strip():
+        return "error", {"error": "snapshot_digest must be a non-empty string"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    fingerprint = {
+        "op": "snapshot_restore",
+        "snapshot_revision": snapshot_revision,
+        "snapshot_digest": snapshot_digest,
+        "high_water_sequence": high_water_sequence,
+        "policy_version": policy_version,
+        "challenge": challenge,
+        "attestation_id": attestation_id,
+        "attestation_ref": attestation_ref,
+        "expected_revision": expected_revision,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "snapshot_restore", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    body = progress.portfolio.get("body")
+    if not body:
+        return "error", {"error": "snapshot_not_found"}
+    current_revision = int(progress.portfolio.get("revision") or 0)
+    current_digest = str(progress.portfolio.get("digest") or "")
+    if expected_revision is not None and (
+        not isinstance(expected_revision, int)
+        or isinstance(expected_revision, bool)
+        or int(expected_revision) != current_revision
+    ):
+        return "error", {"error": "stale_attestation"}
+    if int(snapshot_revision) != current_revision or str(snapshot_digest) != current_digest:
+        return "error", {"error": "snapshot_fork"}
+    record = _find_stored_attestation(
+        progress,
+        snapshot_revision=int(snapshot_revision),
+        snapshot_digest=str(snapshot_digest),
+        attestation_id=str(attestation_id or "").strip() or None,
+    )
+    if record is None:
+        return "error", {"error": "attestation_mismatch"}
+    if attestation_id and str(attestation_id) not in (
+        str(record.get("attestation_id") or ""),
+    ):
+        return "error", {"error": "attestation_mismatch"}
+    canonical = canonical_snapshot_digest(body)
+    if str(record.get("canonical_digest") or "") != canonical:
+        return "error", {"error": "proof_invalid"}
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "status": "restored",
+        "state": "verified",
+        "snapshot_revision": current_revision,
+        "snapshot_digest": current_digest,
+        "high_water_sequence": int(body.get("high_water_sequence") or 0),
+        "policy_version": int((body.get("policy") or {}).get("version") or 1),
+        "proof": str(record.get("proof") or ""),
+        "replayed": False,
+    }
+    record_op(progress, event_id, "snapshot_restore", fingerprint, response)
+    return "committed", response
+
+
+# ── append-only snapshot witness ledger (Cycle 006) ────────────────────────
+
+
+def _witness_leaf_body(
+    *,
+    path_id: str,
+    sequence: int,
+    snapshot_digest: str,
+    attestation_digest: str,
+    challenge: str,
+    event_id: str,
+    witness_id: str,
+    previous_root_digest: str,
+) -> dict[str, Any]:
+    return {
+        "path_id": str(path_id or "")[:200],
+        "sequence": int(sequence),
+        "snapshot_digest": str(snapshot_digest or "")[:300],
+        "attestation_digest": str(attestation_digest or "")[:300],
+        "challenge": str(challenge or "")[:200],
+        "event_id": str(event_id or "")[:200],
+        "witness_id": str(witness_id or "")[:200],
+        "previous_root_digest": str(previous_root_digest or "")[:300],
+    }
+
+
+def _witness_leaf_digest(leaf_body: dict[str, Any]) -> str:
+    return sha256_hex(stable_json(leaf_body))
+
+
+def _witness_root(leaves: list[dict[str, Any]]) -> str:
+    if not leaves:
+        return ""
+    current = str(leaves[0].get("leaf_digest") or "")
+    for leaf in leaves[1:]:
+        current = sha256_hex(current + str(leaf.get("leaf_digest") or ""))
+    return current
+
+
+def snapshot_witness(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    snapshot_revision: Any,
+    snapshot_digest: Any,
+    attestation_id: str | None,
+    attestation_digest: Any,
+    challenge: str,
+    witness_id: str | None,
+    expected_sequence: Any,
+    previous_root_digest: Any,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    if not isinstance(snapshot_revision, int) or isinstance(snapshot_revision, bool) or snapshot_revision < 0:
+        return "error", {"error": "snapshot_revision must be a non-negative integer"}
+    if not isinstance(snapshot_digest, str) or not snapshot_digest.strip():
+        return "error", {"error": "snapshot_digest must be a non-empty string"}
+    if not isinstance(attestation_digest, str) or not attestation_digest.strip():
+        return "error", {"error": "attestation_digest must be a non-empty string"}
+    if not isinstance(event_id, str) or not event_id.strip():
+        return "error", {"error": "event_id must be a non-empty string"}
+    if not isinstance(expected_sequence, int) or isinstance(expected_sequence, bool) or expected_sequence < 0:
+        return "error", {"error": "expected_sequence must be a non-negative integer"}
+    witness_id = str(witness_id or "").strip() or ("witness-" + sha256_hex(event_id)[:24])
+    fingerprint = {
+        "op": "snapshot_witness",
+        "snapshot_revision": snapshot_revision,
+        "snapshot_digest": snapshot_digest,
+        "attestation_id": attestation_id,
+        "attestation_digest": attestation_digest,
+        "challenge": challenge,
+        "witness_id": witness_id,
+        "expected_sequence": expected_sequence,
+        "previous_root_digest": previous_root_digest,
+        "event_id": event_id,
+    }
+    outcome, stored = _begin_op(progress, event_id, "snapshot_witness", fingerprint)
+    if outcome == "replayed":
+        return "replayed", stored
+    if outcome == "conflict":
+        return "error", {"error": "event_conflict"}
+    body = progress.portfolio.get("body")
+    if not body:
+        return "error", {"error": "snapshot_not_found"}
+    current_revision = int(progress.portfolio.get("revision") or 0)
+    current_digest = str(progress.portfolio.get("digest") or "")
+    if int(snapshot_revision) != current_revision or str(snapshot_digest) != current_digest:
+        return "error", {"error": "attestation_mismatch"}
+    record = _find_stored_attestation(
+        progress,
+        snapshot_revision=int(snapshot_revision),
+        snapshot_digest=str(snapshot_digest),
+        attestation_id=str(attestation_id or "").strip() or None,
+    )
+    if record is None:
+        return "error", {"error": "attestation_mismatch"}
+    if attestation_id and str(attestation_id) not in (str(record.get("attestation_id") or ""),):
+        return "error", {"error": "attestation_mismatch"}
+    canonical = canonical_snapshot_digest(body)
+    if str(record.get("canonical_digest") or "") != canonical:
+        return "error", {"error": "attestation_mismatch"}
+    if str(attestation_digest or "") != str(record.get("canonical_digest") or ""):
+        return "error", {"error": "attestation_mismatch"}
+    chain = progress.witness_entries
+    if int(expected_sequence) != len(chain):
+        return "error", {"error": "stale_witness_head"}
+    previous_root = _witness_root(chain)
+    if previous_root_digest not in (None, ""):
+        if str(previous_root_digest) != previous_root:
+            return "error", {"error": "stale_witness_head"}
+    for entry in chain:
+        if entry.get("witness_id") == witness_id:
+            return "error", {"error": "event_conflict"}
+    sequence = len(chain) + 1
+    if sequence > _WITNESS_LIMIT:
+        return "error", {"error": "witness_mismatch"}
+    leaf_body = _witness_leaf_body(
+        path_id=path_id,
+        sequence=sequence,
+        snapshot_digest=str(snapshot_digest),
+        attestation_digest=str(attestation_digest),
+        challenge=str(challenge or "")[:200],
+        event_id=event_id,
+        witness_id=witness_id,
+        previous_root_digest=previous_root,
+    )
+    leaf_digest = _witness_leaf_digest(leaf_body)
+    root_digest = sha256_hex(previous_root + leaf_digest) if previous_root else leaf_digest
+    inclusion_proof = [str(entry.get("leaf_digest") or "") for entry in chain]
+    consistency_proof = [str(chain[-1].get("root_digest") or "")] if chain else []
+    entry = {
+        "witness_id": witness_id,
+        "sequence": sequence,
+        "snapshot_digest": str(snapshot_digest),
+        "attestation_digest": str(attestation_digest),
+        "attestation_id": str(attestation_id or "")[:200] if attestation_id else str(record.get("attestation_id") or ""),
+        "challenge": str(challenge or "")[:200],
+        "event_id": event_id,
+        "previous_root_digest": previous_root,
+        "leaf_digest": leaf_digest,
+        "root_digest": root_digest,
+        "inclusion_proof": inclusion_proof,
+        "consistency_proof": consistency_proof,
+        "leaf_body": leaf_body,
+    }
+    chain.append(entry)
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "state": "witnessed",
+        "status": "witnessed",
+        "witness_id": witness_id,
+        "witness_sequence": sequence,
+        "snapshot_digest": str(snapshot_digest),
+        "attestation_digest": str(attestation_digest),
+        "previous_root_digest": previous_root,
+        "leaf_digest": leaf_digest,
+        "root_digest": root_digest,
+        "inclusion_proof": bounded_copy(inclusion_proof, 100),
+        "consistency_proof": bounded_copy(consistency_proof, 100),
+        "replayed": False,
+    }
+    record_op(progress, event_id, "snapshot_witness", fingerprint, response)
+    return "committed", response
+
+
+def _find_witness(progress: LearningProgress, witness_id: str | None, sequence: int | None) -> dict[str, Any] | None:
+    for entry in reversed(progress.witness_entries):
+        if witness_id and entry.get("witness_id") == witness_id:
+            return entry
+        if sequence is not None and int(entry.get("sequence") or 0) == int(sequence):
+            return entry
+        if not witness_id and sequence is None:
+            return entry
+    return None
+
+
+def snapshot_verify(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    witness_id: str | None,
+    witness_sequence: Any,
+    snapshot_digest: Any,
+    attestation_digest: Any,
+    leaf_digest: Any,
+    root_digest: Any,
+    previous_root_digest: Any,
+    inclusion_proof: Any,
+    consistency_proof: Any,
+    event_id: str,
+    as_of: int | None,
+) -> tuple[str, dict[str, Any]]:
+    # Verification is intentionally read-only.  Older revisions recorded an
+    # idempotency entry for a successful verification, which meant that a
+    # supposedly read-only provenance check changed the persisted learner
+    # record.  ``event_id`` remains accepted for wire compatibility but is not
+    # persisted or included in any proof.
+    sequence = witness_sequence if isinstance(witness_sequence, int) and not isinstance(witness_sequence, bool) else None
+    entry = _find_witness(progress, witness_id, sequence)
+    if entry is None:
+        return "error", {"error": "witness_mismatch"}
+    chain = progress.witness_entries[: int(entry.get("sequence") or 0)]
+    recomputed_leaf = _witness_leaf_digest(entry.get("leaf_body") or {})
+    recomputed_root = _witness_root(chain)
+    if str(entry.get("leaf_digest") or "") != str(recomputed_leaf):
+        return "error", {"error": "invalid_inclusion_proof"}
+    if str(leaf_digest or "") != str(entry.get("leaf_digest") or ""):
+        return "error", {"error": "invalid_inclusion_proof"}
+    if str(root_digest or "") != str(entry.get("root_digest") or "") or str(entry.get("root_digest") or "") != str(recomputed_root):
+        return "error", {"error": "witness_mismatch"}
+    if str(previous_root_digest or "") != str(entry.get("previous_root_digest") or ""):
+        return "error", {"error": "stale_witness_head"}
+    if str(snapshot_digest or "") != str(entry.get("snapshot_digest") or ""):
+        return "error", {"error": "attestation_mismatch"}
+    if str(attestation_digest or "") != str(entry.get("attestation_digest") or ""):
+        return "error", {"error": "attestation_mismatch"}
+    stored_inclusion = entry.get("inclusion_proof") or []
+    stored_consistency = entry.get("consistency_proof") or []
+    if not isinstance(inclusion_proof, list) or list(inclusion_proof) != stored_inclusion:
+        return "error", {"error": "invalid_inclusion_proof"}
+    if not isinstance(consistency_proof, list) or list(consistency_proof) != stored_consistency:
+        return "error", {"error": "invalid_consistency_proof"}
+    response = {
+        "schema_version": SCHEMA_VERSION,
+        "state": "verified",
+        "status": "verified",
+        "witness_id": entry.get("witness_id"),
+        "witness_sequence": int(entry.get("sequence") or 0),
+        "snapshot_digest": entry.get("snapshot_digest"),
+        "attestation_digest": entry.get("attestation_digest"),
+        "leaf_digest": entry.get("leaf_digest"),
+        "root_digest": entry.get("root_digest"),
+        "previous_root_digest": entry.get("previous_root_digest"),
+        "inclusion_proof": bounded_copy(stored_inclusion, 100),
+        "consistency_proof": bounded_copy(stored_consistency, 100),
+        "inclusion_valid": True,
+        "consistency_valid": True,
+        "read_only": True,
+    }
+    return "read_only", response
+
+
+def _chain_audit_error(
+    error: str,
+    *,
+    sequence: int,
+    current_sequence: int,
+    current_root_digest: str,
+    detail: str,
+) -> tuple[None, dict[str, Any]]:
+    """Return a bounded, non-secret failure record for a read-only audit."""
+    return None, {
+        "schema_version": SCHEMA_VERSION,
+        "status": "rejected",
+        "state": "unverified",
+        "error": error,
+        "detail": str(detail or "")[:200],
+        "first_invalid_sequence": int(sequence),
+        "current_sequence": int(current_sequence),
+        "current_root_digest": str(current_root_digest or ""),
+        "read_only": True,
+    }
+
+
+def snapshot_chain_audit(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    expected_sequence: Any = None,
+    expected_root_digest: Any = None,
+    limit: Any = 100,
+    as_of: int | None = None,
+) -> tuple[dict[str, Any] | None, dict[str, Any]]:
+    """Audit the complete persisted witness chain without mutating it.
+
+    Every stored leaf, duplicate binding, previous-root link, inclusion proof,
+    consistency proof, leaf digest, and accumulated root is recomputed from
+    persisted state.  The caller may fence the read with the head it already
+    observed; a stale or changed head is rejected rather than silently
+    replaced.  Only the returned entry summaries are limited -- the full
+    bounded chain is always checked.
+    """
+    resolved_limit = _validated_limit(limit, default=100)
+    if resolved_limit is None:
+        return None, {"error": "limit must be an integer in 1..100", "read_only": True}
+    if expected_sequence is not None and (
+        not isinstance(expected_sequence, int)
+        or isinstance(expected_sequence, bool)
+        or expected_sequence < 0
+    ):
+        return None, {
+            "error": "expected_sequence must be a non-negative integer",
+            "read_only": True,
+        }
+    if expected_root_digest is not None and not isinstance(expected_root_digest, str):
+        return None, {"error": "expected_root_digest must be a string", "read_only": True}
+
+    chain = progress.witness_entries
+    current_sequence = len(chain)
+    stored_head_root = str(chain[-1].get("root_digest") or "") if chain else ""
+    if expected_sequence is not None and expected_sequence != current_sequence:
+        return _chain_audit_error(
+            "stale_witness_head",
+            sequence=current_sequence,
+            current_sequence=current_sequence,
+            current_root_digest=stored_head_root,
+            detail="expected sequence does not match the persisted head",
+        )
+    if expected_root_digest is not None and expected_root_digest != stored_head_root:
+        return _chain_audit_error(
+            "stale_witness_head",
+            sequence=current_sequence,
+            current_sequence=current_sequence,
+            current_root_digest=stored_head_root,
+            detail="expected root does not match the persisted head",
+        )
+
+    prior_leaf_digests: list[str] = []
+    previous_root = ""
+    seen_witness_ids: set[str] = set()
+    seen_event_ids: set[str] = set()
+    summaries: list[dict[str, Any]] = []
+    for expected_index, entry in enumerate(chain, start=1):
+        if not isinstance(entry, dict):
+            return _chain_audit_error(
+                "witness_chain_corrupt",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="entry is not an object",
+            )
+        body = entry.get("leaf_body")
+        if not isinstance(body, dict):
+            return _chain_audit_error(
+                "witness_chain_corrupt",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="leaf body is missing",
+            )
+        if int(entry.get("sequence") or 0) != expected_index or int(body.get("sequence") or 0) != expected_index:
+            return _chain_audit_error(
+                "witness_chain_fork",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="witness sequences are not contiguous",
+            )
+        if str(body.get("path_id") or "") != str(path_id or ""):
+            return _chain_audit_error(
+                "foreign_witness_path",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="leaf belongs to a different mastery path",
+            )
+
+        witness_id = str(entry.get("witness_id") or "")
+        event_id = str(entry.get("event_id") or "")
+        if not witness_id or witness_id in seen_witness_ids or not event_id or event_id in seen_event_ids:
+            return _chain_audit_error(
+                "witness_chain_fork",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="duplicate or empty witness/event identity",
+            )
+        seen_witness_ids.add(witness_id)
+        seen_event_ids.add(event_id)
+
+        duplicate_fields = (
+            "witness_id",
+            "snapshot_digest",
+            "attestation_digest",
+            "challenge",
+            "event_id",
+            "previous_root_digest",
+        )
+        if any(str(body.get(name) or "") != str(entry.get(name) or "") for name in duplicate_fields):
+            return _chain_audit_error(
+                "witness_chain_corrupt",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="leaf body does not match its stored bindings",
+            )
+        if str(entry.get("previous_root_digest") or "") != previous_root:
+            return _chain_audit_error(
+                "witness_chain_fork",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="previous-root link does not match the audited prefix",
+            )
+
+        leaf_digest = _witness_leaf_digest(body)
+        if str(entry.get("leaf_digest") or "") != leaf_digest:
+            return _chain_audit_error(
+                "witness_chain_corrupt",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="leaf digest mismatch",
+            )
+        root_digest = sha256_hex(previous_root + leaf_digest) if previous_root else leaf_digest
+        if str(entry.get("root_digest") or "") != root_digest:
+            return _chain_audit_error(
+                "witness_chain_corrupt",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="root digest mismatch",
+            )
+        if entry.get("inclusion_proof") != prior_leaf_digests:
+            return _chain_audit_error(
+                "invalid_inclusion_proof",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="stored inclusion proof does not match the audited prefix",
+            )
+        expected_consistency = [previous_root] if previous_root else []
+        if entry.get("consistency_proof") != expected_consistency:
+            return _chain_audit_error(
+                "invalid_consistency_proof",
+                sequence=expected_index,
+                current_sequence=current_sequence,
+                current_root_digest=stored_head_root,
+                detail="stored consistency proof does not match the audited prefix",
+            )
+
+        summaries.append(
+            {
+                "witness_id": witness_id,
+                "witness_sequence": expected_index,
+                "snapshot_digest": str(entry.get("snapshot_digest") or ""),
+                "attestation_digest": str(entry.get("attestation_digest") or ""),
+                "leaf_digest": leaf_digest,
+                "previous_root_digest": previous_root,
+                "root_digest": root_digest,
+            }
+        )
+        prior_leaf_digests.append(leaf_digest)
+        previous_root = root_digest
+
+    # Re-check the caller's root after recomputation.  This distinguishes a
+    # self-consistent stored value from the actual audited head.
+    if expected_root_digest is not None and expected_root_digest != previous_root:
+        return _chain_audit_error(
+            "stale_witness_head",
+            sequence=current_sequence,
+            current_sequence=current_sequence,
+            current_root_digest=previous_root,
+            detail="expected root changed during full-chain verification",
+        )
+    head = summaries[-1] if summaries else None
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "status": "verified",
+        "state": "verified",
+        "path_id": str(path_id or ""),
+        "as_of": as_of_time(as_of),
+        "witness_count": current_sequence,
+        "witness_sequence": current_sequence,
+        "root_digest": previous_root,
+        "head": bounded_copy(head, 20) if head else None,
+        "entries": bounded_copy(summaries[-resolved_limit:], resolved_limit),
+        "entries_truncated": len(summaries) > resolved_limit,
+        "chain_valid": True,
+        "head_matches": True,
+        "read_only": True,
+    }, {}
+
+
+# ── adaptive evidence processing (called from mastery_grade) ───────────────
+
+
+def process_adaptive_evidence(
+    progress: LearningProgress,
+    *,
+    path_id: str,
+    session_id: str,
+    event_id: str,
+    topic_id: str,
+    question_id: str,
+    answer: str,
+    is_correct: bool,
+    observed_at: int,
+    context: dict[str, Any],
+) -> tuple[dict[str, Any], bool]:
+    """Update the adaptive session for one graded answer.
+
+    Returns ``(adaptive_output, mutated)``.  The caller persists the progress
+    when ``mutated`` is True.  Exact event replays return the stored output
+    without mutating; conflicts fail without mutating.
+    """
+    session = progress.adaptive_state.get(topic_id)
+    fingerprint = {
+        "op": "adaptive_evidence",
+        "event_id": event_id,
+        "topic_id": topic_id,
+        "question_id": question_id,
+        "answer": str(answer or "")[:200],
+        "is_correct": bool(is_correct),
+        "observed_at": int(observed_at),
+        "session_id": str(session_id or "")[:200],
+    }
+    stored = peek_record(progress, event_id, "adaptive_evidence")
+    if stored is not None:
+        if record_op(progress, event_id, "adaptive_evidence", fingerprint, {})[0] == "conflict":
+            return {"error": "event_conflict"}, False
+        return dict(stored), False
+    if session is None:
+        if is_correct:
+            # Benign path: no persistent diagnosis, no events, no remediation.
+            virtual = _session_from_context(context, session_id=session_id)
+            virtual["bank"] = _bank_from_context(context)
+            virtual["evidence"] = [
+                {
+                    "event_id": event_id,
+                    "session_id": session_id,
+                    "question_id": question_id,
+                    "answer": str(answer or "")[:500],
+                    "is_correct": bool(is_correct),
+                    "observed_at": int(observed_at),
+                    "source": "adaptive_quiz",
+                }
+            ]
+            outcome = _match_outcome(virtual, question_id, answer, is_correct)
+            if outcome is None:
+                outcome = _conservative_outcome(virtual)
+            update_beliefs(virtual["hypotheses"], outcome.get("likelihoods") or {}, 0.1)
+            selected = select_next_question(virtual)
+            output = _build_adaptive_output(virtual, action="observe", selected_question_id=selected, event_id=event_id)
+            record_op(progress, event_id, "adaptive_evidence", fingerprint, output)
+            return output, False
+        session = _session_from_context(context, session_id=session_id)
+        session["bank"] = _bank_from_context(context)
+        progress.adaptive_state[topic_id] = session
+    else:
+        bank = _bank_from_context(context)
+        if bank:
+            session["bank"] = bank
+        session["catalog"] = _catalog_from_context(context)
+    session["last_session_id"] = str(session_id or "")[:200]
+    evidence_item = {
+        "event_id": event_id,
+        "session_id": session_id,
+        "question_id": question_id,
+        "answer": str(answer or "")[:500],
+        "is_correct": bool(is_correct),
+        "observed_at": int(observed_at),
+        "source": "adaptive_quiz",
+    }
+    session.setdefault("evidence", []).append(evidence_item)
+    if len(session["evidence"]) > _EVIDENCE_LIMIT:
+        session["evidence"] = session["evidence"][-_EVIDENCE_LIMIT:]
+    session.setdefault("used_questions", []).append(question_id)
+    entry = _find_bank_entry(session, question_id)
+    if entry is not None:
+        session["budget_spent"] = int(session.get("budget_spent") or 0) + int(entry.get("cost") or 0)
+    outcome = _match_outcome(session, question_id, answer, is_correct)
+    if outcome is None:
+        outcome = _conservative_outcome(session)
+    update_beliefs(session["hypotheses"], outcome.get("likelihoods") or {}, 0.1)
+    append_event(
+        progress,
+        event_type="adaptive_evidence_recorded",
+        topic_id=topic_id,
+        source_event_id=event_id,
+        occurred_at=int(observed_at),
+        aggregate_kind="adaptive_session",
+        aggregate_id=topic_id,
+        aggregate_revision=len(session["evidence"]),
+        data={
+            "event_id": event_id,
+            "question_id": question_id,
+            "is_correct": bool(is_correct),
+            "observed_at": int(observed_at),
+        },
+    )
+    invalidate_snapshot(progress)
+    action = "diagnose"
+    selected = select_next_question(session)
+    top = _remediable(session)
+    evidence_count = len(session["evidence"])
+    if (
+        not session.get("remediated")
+        and top is not None
+        and evidence_count >= 2
+        and (
+            float(top.get("confidence") or 0.0) >= float(session.get("diagnosis_threshold") or 0.0)
+            or selected is None
+        )
+    ):
+        diagnosis_type = str(top.get("diagnosis_type") or "").strip()
+        catalog = session.get("catalog") or {}
+        remediation = catalog.get(diagnosis_type) or {
+            "strategy": "contrastive_examples",
+            "content": "",
+        }
+        session["remediation"] = bounded_copy(remediation, 5)
+        session["retest"] = _retest_from_bank(session)
+        task = create_review_task(
+            progress,
+            path_id=path_id,
+            session=session,
+            source_event_id=event_id,
+            occurred_at=int(observed_at),
+        )
+        if task is not None:
+            session["review_task_id"] = task.get("task_id")
+        delivery = _create_delivery(
+            progress,
+            path_id=path_id,
+            session=session,
+            task=task,
+            source_event_id=event_id,
+            occurred_at=int(observed_at),
+        )
+        session["delivery_id"] = delivery.get("delivery_id")
+        session["remediated"] = True
+        for hypothesis in session["hypotheses"]:
+            hypothesis["status"] = "candidate"
+        top["status"] = "active"
+        action = "remediate"
+        selected = None
+    else:
+        retest_result = apply_retest_outcome(
+            progress,
+            path_id=path_id,
+            session=session,
+            question_id=question_id,
+            is_correct=is_correct,
+            observed_at=int(observed_at),
+            source_event_id=event_id,
+        )
+        if retest_result is not None:
+            action = "retest_correct" if retest_result["outcome"] == "completed" else "retest_failed"
+        for hypothesis in session["hypotheses"]:
+            hypothesis["status"] = "active" if (session.get("remediated") and hypothesis.get("id") == top_hypothesis_id(session)) else "candidate"
+    output = _build_adaptive_output(session, action=action, selected_question_id=selected, event_id=event_id)
+    record_op(progress, event_id, "adaptive_evidence", fingerprint, output)
+    return output, True
+
+
+def top_hypothesis_id(session: dict[str, Any]) -> str:
+    hypotheses = session.get("hypotheses") or []
+    if not hypotheses:
+        return ""
+    return max(hypotheses, key=lambda h: float(h.get("confidence") or 0.0)).get("id") or ""
+
+
+# ── production redo integration ────────────────────────────────────────────
+
+
+def perform_redo(progress: LearningProgress, *, path_id: str, reason: str = "production redo") -> None:
+    as_of = int(time.time())
+    for topic_id in list(progress.adaptive_state.keys()):
+        session = progress.adaptive_state.get(topic_id)
+        for task in progress.review_tasks:
+            if task.get("topic_id") == topic_id and task.get("state") not in ("completed", "cancelled"):
+                _cancel_task(progress, task, path_id=path_id, reason=reason, occurred_at=as_of, source_event_id=f"redo:{path_id}")
+        for delivery in progress.deliveries:
+            if delivery.get("topic_id") == topic_id and delivery.get("status") in ("open", "claimed"):
+                delivery["status"] = "cancelled"
+                delivery["cancelled_at"] = int(as_of)
+                delivery["cancel_reason"] = str(reason or "")[:200]
+        if session is not None:
+            append_event(
+                progress,
+                event_type="adaptive_reset",
+                topic_id=topic_id,
+                source_event_id=f"redo:{path_id}",
+                occurred_at=as_of,
+                aggregate_kind="adaptive_session",
+                aggregate_id=topic_id,
+                aggregate_revision=int(session.get("reset_count") or 1) + 1,
+                data={"topic_id": topic_id, "reason": str(reason or "")[:200], "reset_at": int(as_of)},
+            )
+        progress.adaptive_state.pop(topic_id, None)
+    if progress.event_feed or progress.review_tasks:
+        invalidate_snapshot(progress)
+
+
+__all__ = [
+    "SCHEMA_VERSION",
+    "stable_json",
+    "sha256_hex",
+    "digest",
+    "bounded_copy",
+    "as_of_time",
+    "validate_review_policy",
+    "validate_adaptive_context",
+    "validate_policy_data",
+    "learning_events_payload",
+    "learning_checkpoint",
+    "review_plan_payload",
+    "review_reschedule",
+    "remediation_status_payload",
+    "remediation_reset",
+    "remediation_claim",
+    "remediation_ack",
+    "policy_status_payload",
+    "policy_publish",
+    "handoff_create",
+    "handoff_list_payload",
+    "handoff_resume",
+    "handoff_abandon",
+    "snapshot_payload",
+    "snapshot_checkpoint",
+    "snapshot_attest",
+    "snapshot_restore",
+    "snapshot_witness",
+    "snapshot_verify",
+    "snapshot_chain_audit",
+    "process_adaptive_evidence",
+    "invalidate_snapshot",
+    "perform_redo",
+]
