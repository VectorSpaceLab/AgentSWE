+class MasteryRemediationStatusTool(BaseTool):
+    """Read the persistent remediation state for a topic on the active path."""
+
+    def get_definition(self) -> ToolDefinition:
+        return ToolDefinition(
+            name="mastery_remediation_status",
+            description=(
+                "Read the persistent adaptive-remediation state for a topic: "
+                "hypotheses, evidence, the next ordered delivery item, and any "
+                "review tasks. Never fabricate state; read it here."
+            ),
+            parameters=[
+                ToolParameter(name="topic_id", type="string", description="Topic to inspect."),
+                ToolParameter(name="as_of", type="integer", required=False, description="Optional current Unix time."),
+            ],
+        )
+
+    async def execute(self, **kwargs: Any) -> ToolResult:
+        path_id = _resolve_path_id(kwargs)
+        if not path_id:
+            return _no_path_result()
+        from deeptutor.learning.adaptive import remediation_status_payload
+
+        topic_id = str(kwargs.get("topic_id") or "").strip()
+        if not topic_id:
+            return _json_result(
+                {"status": "rejected", "error": "topic_id must be a non-empty string"},
+                meta_key="mastery_remediation_status",
+                success=False,
+            )
+        service = _new_service()
+        progress = service.get_or_create(path_id)
+        payload = remediation_status_payload(progress, topic_id=topic_id, as_of=kwargs.get("as_of"))
+        return _json_result(payload, meta_key="mastery_remediation_status")
+
