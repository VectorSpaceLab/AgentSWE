diff --git a/deeptutor/learning/tests/test_snapshot_chain_audit.py b/deeptutor/learning/tests/test_snapshot_chain_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..c2355b7dfd24ab3e27a6037a8d00e5c75247b151
--- /dev/null
+++ b/deeptutor/learning/tests/test_snapshot_chain_audit.py
@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+from copy import deepcopy
+import json
+import unittest
+
+from deeptutor.learning.adaptive import (
+    snapshot_attest,
+    snapshot_chain_audit,
+    snapshot_payload,
+    snapshot_verify,
+    snapshot_witness,
+)
+from deeptutor.learning.models import LearningProgress
+
+
+def _state(progress: LearningProgress) -> str:
+    return json.dumps(progress.model_dump(mode="json"), sort_keys=True, separators=(",", ":"))
+
+
+def _witnessed_progress() -> tuple[LearningProgress, dict[str, object], dict[str, object]]:
+    progress = LearningProgress(book_id="path-a")
+    snapshot, error = snapshot_payload(progress, as_of=100, limit=50, include_terminal=True)
+    assert snapshot is not None and not error
+
+    attestations: list[dict[str, object]] = []
+    witnesses: list[dict[str, object]] = []
+    previous_root = ""
+    for index in (1, 2):
+        outcome, attestation = snapshot_attest(
+            progress,
+            snapshot_revision=snapshot["snapshot_revision"],
+            snapshot_digest=snapshot["digest"],
+            high_water_sequence=snapshot["high_water_sequence"],
+            policy_version=snapshot["policy"]["version"],
+            challenge=f"challenge-{index}",
+            attestation_id=f"attestation-{index}",
+            event_id=f"attest-event-{index}",
+            as_of=100 + index,
+        )
+        assert outcome == "committed"
+        outcome, witness = snapshot_witness(
+            progress,
+            path_id="path-a",
+            snapshot_revision=snapshot["snapshot_revision"],
+            snapshot_digest=snapshot["digest"],
+            attestation_id=attestation["attestation_id"],
+            attestation_digest=attestation["canonical_digest"],
+            challenge=f"challenge-{index}",
+            witness_id=f"witness-{index}",
+            expected_sequence=index - 1,
+            previous_root_digest=previous_root,
+            event_id=f"witness-event-{index}",
+            as_of=100 + index,
+        )
+        assert outcome == "committed"
+        previous_root = str(witness["root_digest"])
+        attestations.append(attestation)
+        witnesses.append(witness)
+    return progress, witnesses[0], witnesses[1]
+
+
+class SnapshotChainAuditTests(unittest.TestCase):
+    def test_full_chain_audit_and_leaf_verify_are_read_only(self) -> None:
+        progress, _first, second = _witnessed_progress()
+        before = _state(progress)
+
+        audit, error = snapshot_chain_audit(
+            progress,
+            path_id="path-a",
+            expected_sequence=2,
+            expected_root_digest=second["root_digest"],
+            limit=1,
+            as_of=200,
+        )
+        self.assertFalse(error)
+        self.assertIsNotNone(audit)
+        assert audit is not None
+        self.assertTrue(audit["chain_valid"])
+        self.assertTrue(audit["read_only"])
+        self.assertEqual(audit["witness_count"], 2)
+        self.assertEqual(len(audit["entries"]), 1)
+        self.assertTrue(audit["entries_truncated"])
+        self.assertEqual(_state(progress), before)
+
+        outcome, verified = snapshot_verify(
+            progress,
+            path_id="path-a",
+            witness_id=second["witness_id"],
+            witness_sequence=second["witness_sequence"],
+            snapshot_digest=second["snapshot_digest"],
+            attestation_digest=second["attestation_digest"],
+            leaf_digest=second["leaf_digest"],
+            root_digest=second["root_digest"],
+            previous_root_digest=second["previous_root_digest"],
+            inclusion_proof=second["inclusion_proof"],
+            consistency_proof=second["consistency_proof"],
+            event_id="ignored-correlation-id",
+            as_of=200,
+        )
+        self.assertEqual(outcome, "read_only")
+        self.assertTrue(verified["read_only"])
+        self.assertEqual(_state(progress), before)
+
+    def test_audit_rejects_stale_foreign_and_forked_heads_without_repair(self) -> None:
+        progress, _first, second = _witnessed_progress()
+
+        before = _state(progress)
+        audit, error = snapshot_chain_audit(
+            progress,
+            path_id="path-a",
+            expected_sequence=1,
+            expected_root_digest=second["root_digest"],
+            as_of=200,
+        )
+        self.assertIsNone(audit)
+        self.assertEqual(error["error"], "stale_witness_head")
+        self.assertEqual(_state(progress), before)
+
+        foreign = deepcopy(progress)
+        foreign.witness_entries[0]["leaf_body"]["path_id"] = "path-b"
+        foreign_before = _state(foreign)
+        audit, error = snapshot_chain_audit(foreign, path_id="path-a", as_of=200)
+        self.assertIsNone(audit)
+        self.assertEqual(error["error"], "foreign_witness_path")
+        self.assertEqual(_state(foreign), foreign_before)
+
+        forked = deepcopy(progress)
+        forked.witness_entries[1]["previous_root_digest"] = "fork-root"
+        forked.witness_entries[1]["leaf_body"]["previous_root_digest"] = "fork-root"
+        forked_before = _state(forked)
+        audit, error = snapshot_chain_audit(forked, path_id="path-a", as_of=200)
+        self.assertIsNone(audit)
+        self.assertEqual(error["error"], "witness_chain_fork")
+        self.assertEqual(_state(forked), forked_before)
+
+
+if __name__ == "__main__":
+    unittest.main()
