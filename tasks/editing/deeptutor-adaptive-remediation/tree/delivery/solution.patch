+    handoffs: list[dict[str, Any]] = Field(default_factory=list)
+    # Policy registry (Cycle 003): policy_id -> record.
+    policies: dict[str, Any] = Field(default_factory=dict)
+    # Frozen learner portfolio snapshot (Cycle 004+) + attestation state.
+    portfolio: dict[str, Any] = Field(default_factory=dict)
+    # Snapshot-checkpoint subscribers (independent of event checkpoints).
+    snapshot_checkpoints: dict[str, Any] = Field(default_factory=dict)
+    # Idempotency records keyed by mutation event id (bounded, path-local).
+    op_records: dict[str, Any] = Field(default_factory=dict)
+    # Append-only snapshot witness ledger (Cycle 006), newest last.
+    witness_entries: list[dict[str, Any]] = Field(default_factory=list)
 
 
