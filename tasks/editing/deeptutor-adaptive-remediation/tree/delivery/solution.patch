+    def _persist_model_artifact(self, final_text: str) -> None:
+        """Persist the exact model-final JSON when the evaluator opts in."""
+        raw_destination = os.environ.get("DEEPTUTOR_AGENT_RESULT", "").strip()
+        if not raw_destination or not final_text:
+            return
+        temporary_name: str | None = None
+        try:
+            value = json.loads(final_text)
+            if not isinstance(value, dict):
+                raise ValueError("final model response must be a JSON object")
+            required = ("schema_version", "case_id", "status", "summary", "artifacts")
+            missing = [field for field in required if field not in value]
+            if missing:
+                raise ValueError("missing required artifact fields: " + ", ".join(missing))
+            for field in ("schema_version", "case_id", "status", "summary"):
+                if not isinstance(value[field], str) or not value[field].strip():
+                    raise ValueError(f"artifact {field} must be a non-empty string")
+            if not isinstance(value["artifacts"], dict):
+                raise ValueError("artifact artifacts must be a JSON object")
+            expected_case_id = os.environ.get("DEEPTUTOR_CASE_ID", "").strip()
+            if expected_case_id and value["case_id"] != expected_case_id:
+                raise ValueError("artifact case_id does not match DEEPTUTOR_CASE_ID")
+            destination = Path(raw_destination)
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            with tempfile.NamedTemporaryFile(
+                mode="w",
+                encoding="utf-8",
+                dir=destination.parent,
+                prefix=f".{destination.name}.",
+                suffix=".tmp",
+                delete=False,
+            ) as handle:
+                handle.write(final_text)
+                temporary_name = handle.name
+            os.replace(temporary_name, destination)
+        except Exception as exc:
+            if temporary_name:
+                with suppress(OSError):
+                    Path(temporary_name).unlink()
+            logger.warning("model-final artifact was not persisted: %s", exc)
+
