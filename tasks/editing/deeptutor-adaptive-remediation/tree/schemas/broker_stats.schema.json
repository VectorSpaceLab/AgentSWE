{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "title": "DeepTutor product-specific medium lower broker",
      "type": "object",
      "required": ["schema_version", "model", "reasoning_effort", "calls", "successful_calls", "failures", "total_tokens"],
      "properties": {
        "schema_version": {"const": "agentswe-broker-stats/v1"},
        "model": {"const": "gpt-5.6-sol"},
        "reasoning_effort": {"const": "medium"},
        "calls": {"type": "integer", "minimum": 0},
        "successful_calls": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    {
      "title": "Validated shared Builder xhigh Responses broker",
      "type": "object",
      "required": ["runtime", "judge"],
      "properties": {
        "runtime": {
          "type": "object",
          "required": ["calls", "tokens", "failures", "upstream_failures", "delivery_failures", "budget_exceeded"]
        },
        "judge": {"type": "object"},
        "max_runtime_calls": {"type": "integer", "minimum": 0},
        "max_runtime_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  ]
}
