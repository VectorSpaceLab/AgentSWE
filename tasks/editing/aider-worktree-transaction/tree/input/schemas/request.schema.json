{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aider-repository-set-request-v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "repo", "state_dir", "plan_id", "plan", "max_workers", "crash", "coordinator", "lease_seconds"],
  "properties": {
    "schema_version": {"const": 3},
    "operation": {"enum": ["create", "status", "run", "recover", "rollback"]},
    "repo": {"type": "string", "pattern": "^/", "minLength": 2},
    "state_dir": {"type": "string", "pattern": "^/", "minLength": 2},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "plan": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositories", "integration_order", "subtasks", "integration_tests", "publication"],
          "properties": {
            "repositories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {"$ref": "#/$defs/repository"}
            },
            "integration_order": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
            },
            "subtasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {"$ref": "#/$defs/subtask"}
            },
            "integration_tests": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["repository_id", "command"],
                "properties": {
                  "repository_id": {"$ref": "#/$defs/id"},
                  "command": {"$ref": "#/$defs/command"}
                }
              }
            },
            "publication": {
              "type": "object",
              "additionalProperties": false,
              "required": ["targets", "participant_order", "links", "commit_messages", "on_ref_drift", "after_decision"],
              "properties": {
                "targets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {"$ref": "#/$defs/target"}
                },
                "participant_order": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/id"}
                },
                "links": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {"$ref": "#/$defs/link"}
                },
                "commit_messages": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["repository_id", "message"],
                    "properties": {
                      "repository_id": {"$ref": "#/$defs/id"},
                      "message": {"type": "string", "minLength": 1, "maxLength": 1024}
                    }
                  }
                },
                "on_ref_drift": {"const": "abort"},
                "after_decision": {"const": "roll_forward"}
              }
            }
          }
        }
      ]
    },
    "max_workers": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 32}]},
    "crash": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "occurrence", "mode"],
          "properties": {
            "after": {
              "enum": [
                "lease_acquired", "base_snapshot_persisted", "worktree_created",
                "worker_finished", "snapshot_persisted", "worker_committed",
                "merge_applied", "test_recorded", "repository_prepared",
                "federation_prepared", "participant_ref_prepared",
                "commit_decision_recorded", "repository_promoted",
                "participant_refs_committed", "checkout_synced",
                "cleanup_recorded", "rollback_decision_recorded",
                "participant_rollback_committed", "rollback_recorded"
              ]
            },
            "occurrence": {"type": "integer", "minimum": 1},
            "mode": {"enum": ["exit75", "sigkill"]}
          }
        }
      ]
    },
    "coordinator": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "token", "fence"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "token": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z0-9._-]{16,128}$"}]},
            "fence": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
          }
        }
      ]
    },
    "lease_seconds": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 30}]}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "create"}}},
      "then": {"properties": {"plan": {"type": "object"}, "max_workers": {"type": "null"}, "crash": {"type": "null"}, "coordinator": {"type": "object", "properties": {"token": {"type": "null"}, "fence": {"type": "null"}}}, "lease_seconds": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "run"}}},
      "then": {"properties": {"plan": {"type": "null"}, "max_workers": {"type": "integer"}, "coordinator": {"type": "object", "properties": {"token": {"type": "string"}, "fence": {"type": "integer"}}}, "lease_seconds": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "status"}}},
      "then": {"properties": {"plan": {"type": "null"}, "max_workers": {"type": "null"}, "crash": {"type": "null"}, "coordinator": {"type": "null"}, "lease_seconds": {"type": "null"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "recover"}}},
      "then": {"properties": {"plan": {"type": "null"}, "max_workers": {"type": "null"}, "crash": {"type": "null"}, "coordinator": {"type": "object", "properties": {"fence": {"type": "integer"}}}, "lease_seconds": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "rollback"}}},
      "then": {"properties": {"plan": {"type": "null"}, "max_workers": {"type": "null"}, "coordinator": {"type": "object", "properties": {"token": {"type": "string"}, "fence": {"type": "integer"}}}, "lease_seconds": {"type": "integer"}, "crash": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"after": {"enum": ["rollback_decision_recorded", "participant_rollback_committed", "rollback_recorded"]}}}]}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {"argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 4096}}}
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "base_revision", "base_state_policy", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^/", "minLength": 2},
        "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_state_policy": {"enum": ["require_clean", "snapshot"]},
        "role": {"enum": ["root", "component"]}
      }
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository_id", "depends_on", "allowed_paths", "worker", "test"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "repository_id": {"$ref": "#/$defs/id"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
        "worker": {"$ref": "#/$defs/command"},
        "test": {"$ref": "#/$defs/command"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "ref", "expected_oid"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/id"},
        "ref": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"},
        "expected_oid": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_repository_id", "path", "child_repository_id"],
      "properties": {
        "parent_repository_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "child_repository_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
