Subject: [PATCH 0004] Codex resume: resume the single root thread by id instead of `resume --last`

Applies on top of profile 'site'.

--- a/harbor/agents/installed/codex.py
+++ b/harbor/agents/installed/codex.py
@@ -26,6 +26,43 @@
 from harbor.utils.trajectory_utils import format_trajectory_json
 
 
+def _root_session_selector_script(
+    sessions_dir: PurePosixPath,
+    marker_path: PurePosixPath,
+) -> str:
+    """Return the in-container script that selects the one root Codex thread."""
+    return (
+        "python3 - <<'PY'\n"
+        "import json\n"
+        "from pathlib import Path\n"
+        f"sessions = Path({sessions_dir.as_posix()!r})\n"
+        f"marker = Path({marker_path.as_posix()!r})\n"
+        "root_ids = set()\n"
+        "for path in sessions.rglob('*.jsonl'):\n"
+        "    try:\n"
+        "        for line in path.open(encoding='utf-8', errors='replace'):\n"
+        "            try:\n"
+        "                event = json.loads(line)\n"
+        "            except Exception:\n"
+        "                continue\n"
+        "            if event.get('type') != 'session_meta':\n"
+        "                continue\n"
+        "            payload = event.get('payload') or {}\n"
+        "            session_id = payload.get('id')\n"
+        "            if session_id and not payload.get('parent_thread_id'):\n"
+        "                root_ids.add(str(session_id))\n"
+        "    except OSError:\n"
+        "        continue\n"
+        "if len(root_ids) != 1:\n"
+        "    raise SystemExit(\n"
+        "        f'expected exactly one root Codex session, found {sorted(root_ids)!r}'\n"
+        "    )\n"
+        "marker.parent.mkdir(parents=True, exist_ok=True)\n"
+        "marker.write_text(next(iter(root_ids)) + '\\n', encoding='utf-8')\n"
+        "PY"
+    )
+
+
 class Codex(BaseInstalledAgent):
     """
     The Codex agent uses OpenAI's Codex CLI tool to solve tasks.
