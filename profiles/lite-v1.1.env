# lite-v1.1 profile: the configuration the paper's Lite runs used (DeepSeek API for every evaluator role).
AGENTSWE_PROFILE=lite-v1.1
AGENTSWE_RUNTIME_MODEL=deepseek-flash
AGENTSWE_RUNTIME_EFFORT=high
AGENTSWE_JUDGE_MODEL=deepseek-flash
AGENTSWE_JUDGE_EFFORT=max
AGENTSWE_CREATION_RUNTIME_MODEL=deepseek-flash
AGENTSWE_CREATION_RUNTIME_EFFORT=high
AGENTSWE_CREATION_JUDGE_MODEL=deepseek-flash
AGENTSWE_CREATION_JUDGE_EFFORT=max
AGENTSWE_EDITING_RUNTIME_MODEL=deepseek-flash
AGENTSWE_EDITING_RUNTIME_EFFORT=high
AGENTSWE_EDITING_JUDGE_MODEL=deepseek-flash
AGENTSWE_EDITING_JUDGE_EFFORT=max
AGENTSWE_OPTIMIZATION_RUNTIME_MODEL=deepseek-flash
AGENTSWE_OPTIMIZATION_RUNTIME_EFFORT=high
AGENTSWE_OPTIMIZATION_JUDGE_MODEL=deepseek-flash
AGENTSWE_OPTIMIZATION_JUDGE_EFFORT=max
