# Paper profile: the role models and efforts of the paper runs (provider URLs and keys come from your .env).
AGENTSWE_PROFILE=paper
# Creation: the lower model every created agent calls, and the Result judge.
AGENTSWE_CREATION_RUNTIME_MODEL=gpt-5.6-sol
AGENTSWE_CREATION_RUNTIME_EFFORT=medium
AGENTSWE_CREATION_JUDGE_MODEL=gpt-5.6-sol
AGENTSWE_CREATION_JUDGE_EFFORT=xhigh
# Editing: lower agent and judge on the official DeepSeek API. Its model id `deepseek-flash` is DeepSeek-V4.1-Flash,
# the model the paper calls deepseek-v4.1-flash (verified 2026-10-03; a provider alias whose target may change).
AGENTSWE_EDITING_RUNTIME_MODEL=deepseek-flash
AGENTSWE_EDITING_RUNTIME_EFFORT=high
AGENTSWE_EDITING_JUDGE_MODEL=deepseek-flash
AGENTSWE_EDITING_JUDGE_EFFORT=max
# Optimization: the optimized agent's runtime model and the evaluator's graders.
AGENTSWE_OPTIMIZATION_RUNTIME_MODEL=gpt-5.6-sol
AGENTSWE_OPTIMIZATION_RUNTIME_EFFORT=medium
AGENTSWE_OPTIMIZATION_JUDGE_MODEL=gpt-5.6-sol
AGENTSWE_OPTIMIZATION_JUDGE_EFFORT=medium
# OSWorld vision broker: strict structured output, as in the paper runs.
AGENTSWE_OSWORLD_SCHEMA_STRICT=1
