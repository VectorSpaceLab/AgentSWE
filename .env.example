# AgentSWE configuration. Copy to .env (git-ignored) and fill in the keys.
# Roles: BUILDER = the coding agent under evaluation; RUNTIME = the model a built/edited agent calls at
# evaluation time (only through the evaluator's broker); JUDGE = Result judge, user simulators, LLM graders.
# Any role's BASE_URL / API_KEY / WIRE left empty falls back to the AGENTSWE_DEFAULT_* value.

# --- one provider for everything (default: DeepSeek official API; the commented lines are the built-in values) ---
# With a DeepSeek key, AGENTSWE_DEFAULT_API_KEY is the only line you need. Leave AGENTSWE_DEFAULT_BASE_URL commented
# for DeepSeek: setting it, even to this value, counts as choosing a provider and turns off the smoke-only runtime
# defaults (see per-role overrides below).
# AGENTSWE_DEFAULT_BASE_URL=https://api.deepseek.com/v1
AGENTSWE_DEFAULT_API_KEY=
# Any *_API_KEY may instead reference an existing dotenv file without copying the key:
# AGENTSWE_DEFAULT_API_KEY=@file:/path/to/credentials.env#DEEPSEEK_API_KEY
# AGENTSWE_DEFAULT_WIRE=responses          # responses | chat (chat providers are reached through the broker)

# --- configuration profile (profiles/README.md) ---
# AGENTSWE_PROFILE=lite-v1.1               # lite-v1.1: the paper's Lite configuration (deepseek-flash, one DeepSeek key);
#                                          # paper: the paper's role models (needs a provider serving them); unset: paper
#                                          # bytes with the smoke defaults

# --- per-role overrides ---
# The commented values are the built-in defaults (the Lite configuration); leave them commented unless you
# change them. Setting any RUNTIME model/provider/effort counts as an explicit choice and turns off the
# smoke-only runtime defaults (Creation runtime and OSWorld vision broker at effort explicit-none).
# AGENTSWE_BUILDER_MODEL=deepseek-flash
# AGENTSWE_BUILDER_EFFORT=max
# AGENTSWE_BUILDER_BASE_URL=
# AGENTSWE_BUILDER_API_KEY=
# AGENTSWE_RUNTIME_MODEL=deepseek-flash
# AGENTSWE_RUNTIME_EFFORT=high
# AGENTSWE_RUNTIME_BASE_URL=
# AGENTSWE_RUNTIME_API_KEY=
# AGENTSWE_JUDGE_MODEL=deepseek-flash
# AGENTSWE_JUDGE_EFFORT=max
# AGENTSWE_JUDGE_BASE_URL=
# AGENTSWE_JUDGE_API_KEY=

# Example: Qwen builder on a Chat-only provider (the builder broker translates Responses <-> Chat)
# AGENTSWE_BUILDER_BASE_URL=https://api.deepinfra.com/v1/openai
# AGENTSWE_BUILDER_WIRE=chat
# AGENTSWE_BUILDER_MODEL=Qwen/Qwen3.6-35B-A3B

# --- search (tier-2 tasks only; Serper-compatible); the key stays in the search broker ---
# Both are required by T2 tasks and neither has a default; for Serper:
# AGENTSWE_SEARCH_BASE_URL=https://google.serper.dev
# AGENTSWE_SEARCH_API_KEY=
# AGENTSWE_SEARCH_WIRE=serper              # serper | legacy-proxy

# --- optional, provider-dependent ---
# AGENTSWE_BUILDER_CONTEXT_WINDOW=         # only for a builder model unknown to the Codex catalog
# AGENTSWE_CHAT_BROKER_DEFAULT_MAX_TOKENS=65536
# AGENTSWE_EVALUATOR_PROXY_URL=            # loopback http proxy for broker egress

# --- host ---
# AGENTSWE_JUDGE_FORMAT=release            # release (default) | exact. release binds the QA and Security judges'
#                                          # identity to the request (repairs recorded in the score contract) and applies one
#                                          # set of PDF review rules in evaluation and independent verification: the repairing
#                                          # rules the published Lite PDF runs executed. exact makes QA and Security judges echo
#                                          # their request identity verbatim, as the paper's runs required, and applies the
#                                          # stricter PDF review rules without repairs. Use exact with a paper-strength judge.
# AGENTSWE_BUILD_PROXY=http://127.0.0.1:7890 # optional proxy for environment builds and for the pinned files setup
#                                          # fetches (release assets, OSWorld image, Terminal-Bench assets); all
#                                          # checksum-verified. Not used by image builds (use the mirrors below) or by
#                                          # Docker pulls; docs/ENV.md, Behind an HTTP proxy
# AGENTSWE_BUILD_NO_PROXY=localhost,127.0.0.1 # a loopback proxy runs those builds on the host network
# AGENTSWE_HOME=/data/agentswe             # state, environments, runs (default: $XDG_DATA_HOME/agentswe, i.e.
#                                          # ~/.local/share/agentswe). Must be outside any git work tree, this
#                                          # checkout included: evaluators run `git apply` there.
# Docker address pools (docs/ENV.md); pick ranges no other workload or AgentSWE home on the host uses
# AGENTSWE_NETWORK_POOL=10.246.0.0/16       # Creation: per-job /28 Docker subnets are allocated from here
# AGENTSWE_OPTIMIZATION_POOL=198.18.0.0/15  # Optimization: compose-template /28 networks (every Optimization task)
# AGENTSWE_TAU3_POOL=198.18.0.0/15          # tau3-retail controller
# AGENTSWE_PINCHBENCH_POOL=100.64.0.0/10    # pinchbench-openclaw controller
# AGENTSWE_MAX_CONCURRENT_RUNS=4            # per host; more concurrent runs have caused udevd storms
# AGENTSWE_BROKER_HOST=                     # default: the docker0 address
# Package sources (defaults are the public upstreams):
# AGENTSWE_CONDA_CHANNEL=https://conda.anaconda.org/conda-forge
# AGENTSWE_PIP_INDEX_URL=https://pypi.org/simple
# AGENTSWE_NPM_REGISTRY=https://registry.npmjs.org
# AGENTSWE_NODE_DIST_URL=https://nodejs.org/dist
# AGENTSWE_UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
# AGENTSWE_DOCKER_PLUGIN_SOURCE=auto            # auto | github | ubuntu (only if compose/buildx are missing or old)
# AGENTSWE_APT_MIRROR=                      # apt mirror for image builds whose pinned apt snapshot fails
# AGENTSWE_DOCKER_REGISTRY=                 # Docker Hub mirror host for docker.io base images in image builds and
#                                          # Optimization templates (when the daemon has no registry mirror)
# AGENTSWE_GHCR_REGISTRY=ghcr.io            # Terminal-Bench base images
# AGENTSWE_DEBIAN_MIRROR=                   # Debian packages of one Terminal-Bench image
# AGENTSWE_PBS_BASE_URL=https://github.com/astral-sh/python-build-standalone/releases/download
# AGENTSWE_TERMINALBENCH_APT_MIRROR=        # Terminal-Bench task images built during runs: a mirror base serving
#                                          # /ubuntu, /debian and /debian-security
# AGENTSWE_TERMINALBENCH_PIP_INDEX=https://pypi.org/simple   # Terminal-Bench task images built during runs
# AGENTSWE_TERMINALBENCH_GITHUB_DOWNLOAD_BASE=   # Terminal-Bench verifiers: mirror of github.com release downloads
#                                          # for the uv they install (<base>/astral-sh/uv/releases/download/...)
# AGENTSWE_GITHUB_CODELOAD=https://codeload.github.com   # tau3 / PinchBench runtime images; Editing a0 tarballs
# AGENTSWE_A0_SOURCE=git                    # codeload = fetch the Editing a0 sources as commit tarballs
# AGENTSWE_A0_GIT_TIMEOUT=900               # seconds before an Editing a0 git fetch falls back to codeload
# AGENTSWE_PLAYWRIGHT_DOWNLOAD_HOST=        # replaces https://cdn.playwright.dev/dbazure/download/playwright: browsers of
#                                          # the GUI, PPTX, Web, Schema, PDF environments; Dyad's ffmpeg (sha256-pinned)
# AGENTSWE_CFT_BASE_URL=https://storage.googleapis.com/chrome-for-testing-public  # Chrome for Testing mirror: the
#                                          # trusted-browser image and Dyad's Chrome zips (sha256-pinned)
# AGENTSWE_UV_PYTHON_INSTALL_MIRROR=        # uv's Python downloads (Editing host builds)
# AGENTSWE_EDITING_REQUIRE_ADMISSION=0     # 1 = an Editing formal run also requires a readiness admission (the
#                                          # benchmark-construction gate); default: source-integrity checks only
# AGENTSWE_ENV_ARCHIVE_DIR=                # directory (or mount) holding the pinned environment archives that some
#                                          # host-built Editing environments unpack (sha256 pinned in their env.json)
# AGENTSWE_RELEASE_ASSETS_URL=https://github.com/VectorSpaceLab/AgentSWE/releases/download/assets-v1
#                                          # (the default) the AgentSWE release asset store, a GitHub release of this
#                                          # repository; a copy elsewhere can be named instead. setup fetches the files
#                                          # that exist only there (Editing environment archives when
#                                          # AGENTSWE_ENV_ARCHIVE_DIR does not hold them; Terminal-Bench and OSWorld
#                                          # assets), each checked against its pinned size and sha256
# AGENTSWE_RELEASE_ASSETS_LAYOUT=          # flat: files named <sha256[:16]>__<file name> (the default for a
#                                          # .../releases/download/<tag> URL); tree: files at their release paths,
#                                          # e.g. editing/env-archives/<name> (the default for any other URL)
